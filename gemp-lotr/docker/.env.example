# Settings for this Gemp's containers. Copy this file to ".env" beside it and change what you need:
#
#     cp .env.example .env          (copy .env.example .env on Windows)
#
# ".env" is not in the repository (it is in .gitignore), so what you put there, passwords and the PC account's
# client secret included, stays on this machine. docker compose will not start without it.
# Every line here reaches both the compose file (the ${...} in docker-compose.yml) and the app's container.

# ---- Which Gemp this is --------------------------------------------------------------------------------------
# Several Gemps can run on one machine: each needs its own number, which sets its ports, its network and its
# containers' names below.
SERVID=1
COMPOSE_PROJECT_NAME=gemp_${SERVID}

# ---- The app ---------------------------------------------------------------------------------------------------
APP_CONTAINER_NAME=gemp_app_${SERVID}
APP_IP=172.28.${SERVID}.2
# The port the site is reached at on this machine: http://localhost:17001/gemp-lotr/ for SERVID=1
APP_PORT=1700${SERVID}

# ---- The database ----------------------------------------------------------------------------------------------
DB_CONTAINER_NAME=gemp_db_${SERVID}
DB_IP=172.28.${SERVID}.3
# The port the database is reached at on this machine, for a database manager
DB_PORT=3500${SERVID}

# Change these for anything but personal development. The user and password must be the same as
# db.connection.username and db.connection.password in gemp-lotr-common/src/main/resources/gemp-lotr.properties,
# which is where the app reads them.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=gemp_db
MYSQL_USER=gempuser
MYSQL_PASSWORD=gemppassword

# ---- PC accounts (gemp-lotr/PC-ACCOUNT.md, "Turning It On") ---------------------------------------------------
# test:     there are none, and Gemp is as it always was. For local development and test servers.
# optional: sign in with a PC account, or with a password for an account no PC account has claimed; new accounts
#           through a PC account only. Needs every setting below but the last, and the table in
#           db/2026-11-23_player-argonauth.sql.
# Each of these wins over its argonauth.x.y line in gemp-lotr.properties; one left blank here is as if absent.
ARGONAUTH_MODE=test

# Where browsers reach Argonauth. No trailing slash; https unless it is on this machine.
#   A local Argonauth:   http://localhost:1630
ARGONAUTH_ISSUER=

# This Gemp's registration at that Argonauth ("python manage.py client save ..." there). The secret is why this
# file is not in the repository. A test Gemp is never registered at the production Argonauth: links are kept by
# player id, and a test server's ids are production's ids for other people.
#   A local Argonauth has:   gemp-dev   /   gemp-dev-secret
ARGONAUTH_CLIENT_ID=
ARGONAUTH_CLIENT_SECRET=

# This Gemp's two addresses, character for character as registered at Argonauth.
#   Local, SERVID=1:   http://localhost:17001/gemp-lotr-server/argonauth/callback
#                      http://localhost:17001/gemp-lotr/ng/login
ARGONAUTH_REDIRECT_URI=
ARGONAUTH_POSTLOGOUT_URI=

# Only when this server cannot reach Argonauth at the issuer's address: two containers on one machine. Then
# http://host.docker.internal:1630 (on Linux the app's service in docker-compose.yml also needs
# extra_hosts: ["host.docker.internal:host-gateway"]). On the droplets leave it blank.
ARGONAUTH_BACKCHANNEL_URL=
