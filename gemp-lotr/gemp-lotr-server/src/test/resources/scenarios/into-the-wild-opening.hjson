{
	id: into-the-wild-opening
	version: 1
	kind: tutorial
	title: Into the Wild (opening)
	summary: Frodo sets out alone. Learn to move, take a hit, and call for help.
	author: ketura
	tags: movement, twilight, archery, skirmish, reconcile
	format: scenario
	human: freeps
	opponent: {
		name: The Shadow
		fallback: pass
	}
	coverage: strict
	options: {
		autoPass: archery, assignment, regroup
	}

	cards: {
		freeps: {
			# Frodo, Resolute Hobbit
			frodo: 10_121
			# Gandalf, Stormcrow
			gandalf: 0_64
			# Servant of the Secret Fire
			servant1: 1_83
			servant2: 1_83
			# Swordarm of the White Tower
			swordarm1: 1_116
			# Aragorn, Heir of Elendil
			aragorn: 4_109
			# Boromir, Steward's Heir
			boromir: 0_65
			# Noble Intentions
			noble: 1_304
			swordarm2: 1_116
		}
		shadow: {
			# The opponent's own Ring-bearer.  The game puts one on the table for each player; this one never takes a turn.
			oppFrodo: 10_121
			# Goblin Bowman
			bowman: 2_60
			# Mordor Soldier
			soldier: 7_290
			# Goblin Marksman
			marksman1: 1_176
			# Goblin Runner
			runner1: 1_178
			runner2: 1_178
			# Host of Moria
			host: 9_41
			marksman2: 1_176
			# Moria Scout
			scout: 1_191
		}
	}
	ringBearer: {
		freeps: frodo
		shadow: oppFrodo
	}

	# Green Hill Country, Ettenmoors, Rivendell Terrace, Great Chasm
	sites: {
		freeps: 1_323, 1_331, 1_340, 2_118
		shadow: 1_323, 1_331, 1_340, 2_118
	}

	rules: {
		oneSided: true
		freeps: [
			{
				type: modifier
				modifier: {
					type: modifyHandSize
					amount: -4
				}
			}
			# Maneuver is introduced in a later lesson
			{
				type: modifier
				modifier: {
					type: skipPhase
					phase: maneuver
				}
			}
		]
		shadow: [
			{
				type: modifier
				modifier: {
					type: modifyRoamingPenalty
					filter: culture(moria)
					amount: -2
				}
			}
		]
	}

	setup: {
		shadow: {
			hand: bowman
		}
	}

	steps: [
		{
			id: t1-welcome
			when: freeps, action, phase(fellowship), turn(1)
			messages: [
				{
					title: The road goes ever on
					text: This is [[Frodo]]. He has to cross four sites alive. Right now he is alone, at site {site}.
					anchor: card:frodo
					highlight: card:frodo
					side: right
				}
				{
					text: This is the **adventure path**. Each turn you move along it, one site at a time.
					anchor: ui:advPath
					highlight: ui:advPath
					side: right
				}
				{
					text: Every turn starts with your **Fellowship phase**, when you play cards from your hand. Your hand is empty, so there's nothing to play. Click **Pass** to set out.
					anchor: ui:button:pass
				}
			]
			allow: pass
		}
		{
			id: t1-bowman
			when: opponent, action, phase(shadow), turn(1)
			messages: [
				{
					title: Twilight
					text: Moving has a price. The twilight pool now holds {twilight}: the site's shadow number, plus 1 for each companion. Your opponent spends twilight to play **minions**.
					anchor: ui:twilightPool
					highlight: ui:twilightPool
				}
			]
			answer: play(bowman)
		}
		{
			id: t1-assign
			when: freeps, assign, turn(1)
			messages: [
				{
					title: Archery
					text: The [[Goblin Bowman]] is an **archer**. Before any fighting, each archer shoots: Frodo now has {wounds:frodo} wound, and can take {vitality:frodo} more before he dies.
					anchor: card:bowman
					highlight: card:bowman, card:frodo
				}
				{
					title: Assignment
					text: Next you choose who fights each minion. Click the Bowman, then Frodo.
					anchor: card:bowman
					highlight: card:bowman, card:frodo
				}
			]
			allow: assign(frodo: bowman)
		}
		{
			id: t1-choose-skirmish
			when: freeps, cards, text(next skirmish)
			messages: [
				{
					text: Skirmishes are fought one at a time, in the order you choose. There is only one this turn: click Frodo to begin it.
					anchor: card:frodo
					highlight: card:frodo
				}
			]
			allow: choose(frodo)
		}
		{
			id: t1-skirmish
			when: freeps, action, phase(skirmish), skirmish(1)
			messages: [
				{
					title: Skirmish
					text: Strength decides a skirmish. Frodo has {strength:frodo}; the Bowman has {strength:bowman}. Frodo will lose and take another wound. Pass to let it happen.
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: {
				answers: pass
				otherwise: Ettenmoors would let Frodo exert himself for more strength. You could do that in a real game, but it would cost him a wound he can't spare. Let's hold off.
			}
		}
		{
			id: t1-stay
			when: freeps, choice, text(another move)
			messages: [
				{
					title: Regroup
					text: Frodo survived, with {wounds:frodo} wounds. You could move again this turn, but he's in no shape for it. Choose **No** to rest here.
					anchor: ui:alertBox
					avoid: card:frodo
				}
			]
			allow: option(No)
		}
		{
			id: t2-help-arrives
			checkpoint: true
			when: freeps, action, phase(fellowship), turn(2)
			messages: [
				{
					title: Help arrives
					text: At the end of your turn you **reconcile**: you draw back up to a full hand. You now hold four cards.
					anchor: zone:self.hand
					highlight: zone:self.hand
					side: above
				}
				{
					text: "[[Gandalf]] is a **companion**. Playing him costs {cost:gandalf} twilight, which your opponent gets to spend. Click Gandalf to play him."
					anchor: card:gandalf
					highlight: card:gandalf
					avoid: zone:self.characters
				}
			]
			allow: play(gandalf)
		}
		{
			id: t2-set-out
			when: freeps, action, phase(fellowship), turn(2)
			messages: [
				{
					text: The other three cards are **events**. They're played during skirmishes, so hold on to them. Pass to move on to site 3.
					anchor: zone:self.hand
					highlight: card:servant1, card:servant2, card:swordarm1
				}
			]
			allow: pass
			end: complete
		}
	]
}
