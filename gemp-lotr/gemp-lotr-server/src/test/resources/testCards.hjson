{
	# Card definitions that belong to the tests: shapes of definition that no real card has yet and that a
	# mechanic test needs.  VirtualTableScenario makes them known to every table by these ids (set 0).
	# Say on each card which test uses it and why no real card would do.

	# NoEffectFlagTests: a bonus whose cap is a value and not a plain number (a Conditional), as a text such as
	# "(limit +2, or +4 if you can spot a Dwarf)" is written.  No merged card has a cardPhaseLimit of that shape.
	0_8001: {
		title: Test Banner
		unique: false
		side: Free Peoples
		culture: Gondor
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			cost: {
				type: addTwilight
				amount: 1
			}
			effect: {
				type: modifyStrength
				select: choose(companion)
				amount: {
					type: cardPhaseLimit
					limit: {
						type: Conditional
						requires: {
							type: canSpot
							filter: dwarf
						}
						true: 4
						false: 2
					}
					amount: 1
				}
			}
		}
		gametext: <b>Fellowship:</b> Add (1) to make a companion strength +1 (limit +2, or +4 if you can spot a Dwarf).
	}
	# KeywordSnapshotTests: keywords copied with "snapshot: true" from a card whose keyword has a number.  The one
	# real card that takes a snapshot (Northern Signal-fire, Flame of Calenhad 103_86) copies unloaded keywords
	# only, and none of those has a number.
	0_8002: {
		title: Test War-horn
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			cost: {
				type: exert
				select: choose(your,minion)
				memorize: exertedMinion
			}
			effect: [
				{
					type: MemorizeActive
					filter: your,minion,not(memory(exertedMinion))
					memory: otherMinions
				}
				{
					type: AddModifier
					until: start(Regroup)
					modifier: {
						type: AddKeywordFromCards
						filter: memory(otherMinions)
						from: memory(exertedMinion)
						snapshot: true
					}
				}
			]
		}
		gametext: <b>Maneuver:</b> Exert your minion. Until the regroup phase, each of your other minions gains each keyword on that minion.
	}
	# SiteLimitTests: a limit per site written by hand, with the PerSiteLimit requirement and the
	# IncrementPerSiteLimit effect.  The three real cards that are limited per site all use the limitPerSite field.
	0_8003: {
		title: Test Waystone
		unique: false
		side: Free Peoples
		culture: Gondor
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: [
				fellowship
				regroup
			]
			requires: {
				type: PerSiteLimit
				limit: 1
			}
			cost: {
				type: addTwilight
				amount: 1
			}
			effect: [
				{
					type: IncrementPerSiteLimit
					limit: 1
				}
				{
					type: heal
					select: choose(companion)
				}
			]
		}
		gametext: <b>Fellowship</b> <i>or</i> <b>Regroup:</b> Add (1) to heal a companion (limit once per site).
	}
	# CantAddBurdensTests: the definition word cantAddBurdens, which no real card uses yet (F-0159: it used to
	# build a "cannot remove burdens" modifier).  Its filter names the cards that cannot add burdens, any card
	# when it is left out.
	0_8004: {
		title: Test Seal
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: modifier
			modifier: {
				type: cantAddBurdens
			}
		}
		gametext: Burdens cannot be added.
	}
	# GameTextSnapshotTests: game text and keywords given for a time with "snapshot: true", by a card that stays
	# in play past the time it names.  The one real card that copies game text (War Howdah 103_62) gives it until
	# the end of the turn to a minion that is discarded before the turn ends, so the far side of its boundary
	# cannot be read.
	0_8005: {
		title: Test Mirror
		unique: false
		side: Shadow
		culture: Raider
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			effect: [
				{
					type: ChooseActiveCards
					select: choose(your,minion)
					memorize: source
					text: Choose the minion whose game text is given
				}
				{
					type: ChooseActiveCards
					select: choose(your,minion,not(memory(source)))
					memorize: gainer
					text: Choose the minion that gains it
				}
				{
					type: AddModifier
					until: start(Assignment)
					modifier: {
						type: DuplicateGameText
						filter: memory(gainer)
						from: memory(source)
						snapshot: true
					}
				}
				{
					type: AddModifier
					until: start(Assignment)
					modifier: {
						type: AddKeywordFromCards
						filter: memory(gainer)
						from: memory(source)
						snapshot: true
					}
				}
				{
					type: RefreshCard
					select: memory(gainer)
				}
			]
		}
		gametext: <b>Maneuver:</b> Choose your minion and another of your minions. Until the assignment phase, the second gains the game text of the first.
	}
	# CostsAreJudgedInTheOrderPrintedTests: an exertion of a character the player chooses, and then a play from
	# the discard pile of a card that may itself need an exertion.  The real cards that exert a chosen character
	# to play from a discard pile play possessions, minions and conditions, which ask nothing more of him.
	0_8013: {
		title: Test Whetstone
		unique: false
		side: Free Peoples
		culture: Dwarven
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: skirmish
			cost: {
				type: exert
				select: choose(dwarf)
			}
			effect: {
				type: PlayCardFromDiscard
				select: choose(culture(dwarven),event)
			}
		}
		gametext: <b>Skirmish:</b> Exert a Dwarf to play a [dwarven] event from your discard pile.
	}
	# PlacingTheEventPlayedOnADrawDeckTests: a Response that places "that event" (the one whose play it answers)
	# on top of, or beneath, its owner's draw deck, in any phase and for a cost that can always be paid.  The one
	# real text of the kind (Shrouded Elf 13_23 and its erratum 63_23) places the event on top only, for an
	# exertion, in the Elf's own skirmish; no real card places another card's event beneath a draw deck.
	0_8016: {
		title: Test Shelf
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: Response
			trigger: {
				type: played
				filter: your,event
			}
			cost: {
				type: AddTwilight
				amount: 1
			}
			effect: {
				type: PutPlayedEventOnTopOfDrawDeck
				filter: played
			}
		}
		gametext: <b>Response:</b> If you play an event, add (1) to place that event on top of your draw deck.
	}
	0_8017: {
		title: Test Cellar
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: Response
			trigger: {
				type: played
				filter: your,event
			}
			cost: {
				type: AddTwilight
				amount: 1
			}
			effect: {
				type: PutPlayedEventOnBottomOfDrawDeck
				filter: played
			}
		}
		gametext: <b>Response:</b> If you play an event, add (1) to place that event beneath your draw deck.
	}
	# ChoiceWithNothingOnAnyBranchTests: a choice one of whose branches is two effects, the first remembering the
	# cards the second then acts on.  Until that branch is taken nothing is remembered, so it cannot be said
	# beforehand to do nothing, and the question has to be kept.  No real card's choice has a branch that
	# remembers and then acts.
	0_8018: {
		title: Test Fork
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			cost: {
				type: AddTwilight
				amount: 1
			}
			effect: {
				type: choice
				texts: [
					Exert a companion
					Heal each companion
				]
				effects: [
					{
						type: exert
						select: choose(companion)
					}
					[
						{
							type: MemorizeActive
							filter: companion
							memory: toHeal
						}
						{
							type: heal
							select: memory(toHeal)
						}
					]
				]
			}
		}
		gametext: <b>Fellowship:</b> Add (1) to exert a companion or heal each companion.
	}
	# HealBarThatNamesAPlayerTests: a bar on healing that names the player who may not heal.  Every printed
	# "cannot heal" names nobody and stops every heal of the card; the one text that names a player is a Race to
	# Mount Doom modifier (92_35), which lays its bar by a trigger on each heal.  This is the bar by itself.
	0_8019: {
		title: Test Tourniquet
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: modifier
			modifier: {
				type: CantHeal
				filter: minion
				player: you
			}
		}
		gametext: You may not heal minions.
	}
	# StoredValueInATextTests: {stored} in a question that a later action puts, and storeRace.  The one real card
	# whose texts name its stored value (Ulaire Nertea 69_38) names it where its required trigger is described and
	# in a line of the game log; a question put by another action than the one that stored the value is the shape
	# F-0307 was found on, and no card has one now.
	0_8020: {
		title: Test Herald
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: [
			{
				type: Trigger
				optional: false
				trigger: {
					type: played
					filter: self
				}
				effect: [
					{
						type: chooseARace
						memorize: chosenRace
					}
					{
						type: storeRace
						memory: chosenRace
					}
				]
			}
			{
				type: displayableInformation
				text: Named race is {stored}
			}
			{
				type: activated
				phase: fellowship
				effect: {
					type: Optional
					text: Would you like to add (1) for the named race ({stored})?
					effect: {
						type: addTwilight
						amount: 1
					}
				}
			}
		]
		gametext: When you play this condition, name a race.<br><b>Fellowship:</b> You may add (1) for the named race.
	}
	# CanAddBurdensRequirementTests: the requirement canAddBurdens on an action.  The one real card that uses it
	# (Ulaire Nertea 69_38) has it on a standing bar, which only an assignment can read.
	0_8021: {
		title: Test Tally
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			requires: {
				type: canAddBurdens
			}
			effect: {
				type: addTwilight
				amount: 1
			}
		}
		gametext: <b>Fellowship:</b> If a burden could be added, add (1).
	}
	# FreePeoplesPlayerStartsAssigningTriggerTests: the trigger fpStartedAssigning.  It was made in 2021 for Ulaire
	# Nertea 69_38, which no longer uses it (F-0308: her burden is added at the assignment), and no other card has it.
	0_8022: {
		title: Test Drum
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: Trigger
			optional: false
			trigger: {
				type: fpStartedAssigning
			}
			effect: {
				type: addTwilight
				amount: 1
			}
		}
		gametext: Each time the Free Peoples player starts to assign minions, add (1).
	}
	# TransferableToFilterTests: the filter word transferableTo, in a requirement and in a choice, so that the
	# cards it accepts can be read one by one.  The one real card that uses it (Race Text 94_4) has it in the
	# requirement of a trigger on a companion being killed, and "to" there is every other character.
	0_8023: {
		title: Test Porter
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			requires: {
				type: canSpot
				filter: possession,transferableTo(man)
			}
			effect: [
				{
					type: chooseActiveCards
					select: choose(possession,transferableTo(man))
					count: 0-1
					memorize: chosenPossession
					text: Choose a possession that could be transferred to a Man
				}
				{
					type: addTwilight
					amount: 1
				}
			]
		}
		gametext: <b>Fellowship:</b> If a possession could be transferred to a Man, choose up to 1 such possession and add (1).
	}
	# PlayerIsRequirementTests: the requirement playerIs, which asks whether a player's account name is one of a
	# list written in the definition.  The one real card that uses it (Race Text 94_5) lists the accounts of the
	# Dark Lord and of a World Champion, which change hands (Q-0190): these three list names that are nobody's.
	# An account name is letters, digits, "-" and "_" (DbPlayerDAO), so a name with a space in it can be no
	# account.  Shadow cards, so that the player who uses one ("you") is not the Free Peoples player.
	# With no "player" the requirement is asked of the player using the card, and any name of the list will do.
	0_8024: {
		title: Test Roster
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: shadow
			requires: {
				type: playerIs
				names: [
					Warden of the Test Table
					Reeve of the Test Table
				]
			}
			effect: {
				type: addTwilight
				amount: 1
			}
		}
		gametext: <b>Shadow:</b> If you are the Warden of the Test Table or the Reeve of the Test Table, add (1).
	}
	# Asked of this turn's Free Peoples player, as Race Text 94_5 asks it.
	0_8025: {
		title: Test Summons
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: shadow
			requires: {
				type: playerIs
				player: freeps
				names: [
					Warden of the Test Table
				]
			}
			effect: {
				type: addTwilight
				amount: 1
			}
		}
		gametext: <b>Shadow:</b> If the Free Peoples player is the Warden of the Test Table, add (1).
	}
	# Asked of "any" player: met when either player at the table has the name.  No real card asks it so.
	0_8026: {
		title: Test Census
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: shadow
			requires: {
				type: playerIs
				player: any
				names: [
					Warden of the Test Table
				]
			}
			effect: {
				type: addTwilight
				amount: 1
			}
		}
		gametext: <b>Shadow:</b> If any player is the Warden of the Test Table, add (1).
	}
	# DrawDeckShuffledWhenTheLookIsOverTests: a search of ANOTHER player's draw deck that writes its own shuffle
	# (`deck:` names the other player, with `shuffle: true`), once as a discard and once as a removal from the
	# game.  The two Gronds (18_82, 68_82) were the only real cards of that shape; they were corrected to
	# `shuffle: false` and a ShuffleDeck of the deck named (F-0298), so no real card has it now.
	0_8027: {
		title: Test Dredge
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: shadow
			cost: {
				type: removeTwilight
				amount: 1
			}
			effect: {
				type: DiscardCardsFromDrawDeck
				deck: freeps
				select: choose(side(freeps))
				count: 1
				showAll: true
				shuffle: true
				forced: true
			}
		}
		gametext: <b>Shadow:</b> Remove (1) to search the Free Peoples player's draw deck and discard a Free Peoples card found there.
	}
	0_8028: {
		title: Test Trawl
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: shadow
			cost: {
				type: removeTwilight
				amount: 1
			}
			effect: {
				type: RemoveCardsInDeckFromGame
				deck: freeps
				select: choose(side(freeps))
				count: 1
				showAll: true
				shuffle: true
			}
		}
		gametext: <b>Shadow:</b> Remove (1) to search the Free Peoples player's draw deck and remove a Free Peoples card found there from the game.
	}
	# AnOfferThatCostsNothingAndWouldDoNothingIsNotMadeTests (Q-0224): four kinds of effect the engine was taught
	# to ask whether they will do anything, each here as the whole effect of an ability that costs nothing and has
	# no requirement.  Every real card with such an ability carries a requirement written by hand for Q-0034
	# (Dunlending Warrior 4_18, Desert Wind Scout 103_48, Greatest Kingdom of My People 51_16, Race Text 94_4),
	# and that requirement answers before the engine is asked: no real card shows what the effect says of itself.
	0_8029: {
		title: Test Muster
		unique: false
		side: Free Peoples
		culture: Gondor
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			effect: {
				type: enableParticipationInSkirmishes
				select: choose(ally)
				until: start(regroup)
			}
		}
		gametext: <b>Maneuver:</b> Make an ally participate in skirmishes until the regroup phase.
	}
	0_8030: {
		title: Test Salve
		unique: false
		side: Free Peoples
		culture: Gondor
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			effect: {
				type: Restore
				select: choose(side(free people))
			}
		}
		gametext: <b>Fellowship:</b> Restore a Free Peoples card.
	}
	0_8031: {
		title: Test Almanac
		unique: false
		side: Free Peoples
		culture: Gondor
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			effect: [
				{
					type: chooseCardsFromDiscard
					select: choose(side(free people))
					memorize: chosenCard
					text: Choose a Free Peoples card from your discard pile to take into hand
				}
				{
					type: putCardsFromDiscardIntoHand
					select: memory(chosenCard)
				}
			]
		}
		gametext: <b>Fellowship:</b> Choose a Free Peoples card in your discard pile and take it into hand.
	}
	0_8032: {
		title: Test Refrain
		unique: false
		side: Free Peoples
		culture: Gondor
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			effect: {
				type: DoWhile
				check: {
					type: MemoryMatches
					memory: healed
					filter: companion
				}
				effect: {
					type: heal
					select: choose(companion)
					memorize: healed
				}
			}
		}
		gametext: <b>Fellowship:</b> Heal a companion, and again for as long as a companion was healed.
	}
}
