{
	# Card definitions that belong to the tests: shapes of definition that no real card has yet and that a
	# mechanic test needs.  VirtualTableScenario makes them known to every table by these ids (set 0).
	# Say on each card which test uses it and why no real card would do.

	# NoEffectFlagTests: a bonus whose cap is a value and not a plain number (a Conditional), as a text such as
	# "(limit +2, or +4 if you can spot a Dwarf)" is written.  No merged card has a cardPhaseLimit of that shape.
	0_8001: {
		title: Test Banner
		unique: false
		side: Free Peoples
		culture: Gondor
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			cost: {
				type: addTwilight
				amount: 1
			}
			effect: {
				type: modifyStrength
				select: choose(companion)
				amount: {
					type: cardPhaseLimit
					limit: {
						type: Conditional
						requires: {
							type: canSpot
							filter: dwarf
						}
						true: 4
						false: 2
					}
					amount: 1
				}
			}
		}
		gametext: <b>Fellowship:</b> Add (1) to make a companion strength +1 (limit +2, or +4 if you can spot a Dwarf).
	}
	# KeywordSnapshotTests: keywords copied with "snapshot: true" from a card whose keyword has a number.  The one
	# real card that takes a snapshot (Northern Signal-fire, Flame of Calenhad 103_86) copies unloaded keywords
	# only, and none of those has a number.
	0_8002: {
		title: Test War-horn
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			cost: {
				type: exert
				select: choose(your,minion)
				memorize: exertedMinion
			}
			effect: [
				{
					type: MemorizeActive
					filter: your,minion,not(memory(exertedMinion))
					memory: otherMinions
				}
				{
					type: AddModifier
					until: start(Regroup)
					modifier: {
						type: AddKeywordFromCards
						filter: memory(otherMinions)
						from: memory(exertedMinion)
						snapshot: true
					}
				}
			]
		}
		gametext: <b>Maneuver:</b> Exert your minion. Until the regroup phase, each of your other minions gains each keyword on that minion.
	}
	# SiteLimitTests: a limit per site written by hand, with the PerSiteLimit requirement and the
	# IncrementPerSiteLimit effect.  The three real cards that are limited per site all use the limitPerSite field.
	0_8003: {
		title: Test Waystone
		unique: false
		side: Free Peoples
		culture: Gondor
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: [
				fellowship
				regroup
			]
			requires: {
				type: PerSiteLimit
				limit: 1
			}
			cost: {
				type: addTwilight
				amount: 1
			}
			effect: [
				{
					type: IncrementPerSiteLimit
					limit: 1
				}
				{
					type: heal
					select: choose(companion)
				}
			]
		}
		gametext: <b>Fellowship</b> <i>or</i> <b>Regroup:</b> Add (1) to heal a companion (limit once per site).
	}
	# CantAddBurdensTests: the definition word cantAddBurdens, which no real card uses yet (F-0159: it used to
	# build a "cannot remove burdens" modifier).  Its filter names the cards that cannot add burdens, any card
	# when it is left out.
	0_8004: {
		title: Test Seal
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: modifier
			modifier: {
				type: cantAddBurdens
			}
		}
		gametext: Burdens cannot be added.
	}
	# GameTextSnapshotTests: game text and keywords given for a time with "snapshot: true", by a card that stays
	# in play past the time it names.  The one real card that copies game text (War Howdah 103_62) gives it until
	# the end of the turn to a minion that is discarded before the turn ends, so the far side of its boundary
	# cannot be read.
	0_8005: {
		title: Test Mirror
		unique: false
		side: Shadow
		culture: Raider
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			effect: [
				{
					type: ChooseActiveCards
					select: choose(your,minion)
					memorize: source
					text: Choose the minion whose game text is given
				}
				{
					type: ChooseActiveCards
					select: choose(your,minion,not(memory(source)))
					memorize: gainer
					text: Choose the minion that gains it
				}
				{
					type: AddModifier
					until: start(Assignment)
					modifier: {
						type: DuplicateGameText
						filter: memory(gainer)
						from: memory(source)
						snapshot: true
					}
				}
				{
					type: AddModifier
					until: start(Assignment)
					modifier: {
						type: AddKeywordFromCards
						filter: memory(gainer)
						from: memory(source)
						snapshot: true
					}
				}
				{
					type: RefreshCard
					select: memory(gainer)
				}
			]
		}
		gametext: <b>Maneuver:</b> Choose your minion and another of your minions. Until the assignment phase, the second gains the game text of the first.
	}
	# HinderedRingBearerTests: a discard and a return to hand that name their card by side alone and so reach
	# hindered cards (Q-0098), a hindered Ring-bearer among them, each with a cost so that it stays on offer when
	# nothing can be chosen.  No real card does either so plainly: the real discards with "override: hindered"
	# pick out a Shadow card or what a character bears (Doom Causeway 103_127 apart, a site that discards
	# whatever is hindered), and the one real return to hand that reaches hindered cards returns what a
	# companion bears.
	0_8006: {
		title: Test Undertow
		unique: false
		side: Shadow
		culture: Sauron
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			cost: {
				type: removeTwilight
				amount: 1
			}
			effect: {
				type: discard
				select: choose(side(free people))
				override: hindered
			}
		}
		gametext: <b>Maneuver:</b> Remove (1) to discard a Free Peoples card.
	}
	0_8007: {
		title: Test Ebb-tide
		unique: false
		side: Shadow
		culture: Sauron
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			cost: {
				type: removeTwilight
				amount: 1
			}
			effect: {
				type: returnToHand
				select: choose(side(free people))
				override: hindered
			}
		}
		gametext: <b>Maneuver:</b> Remove (1) to return a Free Peoples card to its owner's hand.
	}
	# TheOneRingIsNeverDiscardedTests: a discard of "a card" with no side or type named, reaching hindered cards,
	# and a discard that names The One Ring.  The one real card that can discard the Ring is a site (Doom
	# Causeway 103_127, which discards whatever is hindered); no real card discards "a card" from anywhere in
	# play, and none names the Ring for a discard.
	0_8008: {
		title: Test Riptide
		unique: false
		side: Shadow
		culture: Sauron
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			cost: {
				type: removeTwilight
				amount: 1
			}
			effect: {
				type: discard
				select: choose(any)
				override: hindered
			}
		}
		gametext: <b>Maneuver:</b> Remove (1) to discard a card.
	}
	0_8009: {
		title: Test Maelstrom
		unique: false
		side: Shadow
		culture: Sauron
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			cost: {
				type: removeTwilight
				amount: 1
			}
			effect: {
				type: discard
				select: choose(The One Ring)
			}
		}
		gametext: <b>Maneuver:</b> Remove (1) to discard The One Ring.
	}
	# MapsAndMetaSitesCannotBeHinderedTests: a hinder of "a card" with nothing excepted.  The nearest real card,
	# Pinnacle of Doom 103_129, is a site 9 and excepts companions and The One Ring.
	0_8010: {
		title: Test Fog
		unique: false
		side: Shadow
		culture: Sauron
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: maneuver
			cost: {
				type: removeTwilight
				amount: 1
			}
			effect: {
				type: hinder
				select: choose(any)
			}
		}
		gametext: <b>Maneuver:</b> Remove (1) to hinder a card.
	}
	# ResponseEventsAreNotPlayedByEffectsTests: "play an event" from the discard pile and from a stack with no
	# phase word and no culture in the filter, usable in two phases.  The real cards that play an event from a
	# discard pile name its phase or except response events in their own filters (Now for Ruin 102_52 apart, a
	# condition that plays one when its third token arrives, on a minion's death), and no real card plays an
	# event from a stack by an effect.
	0_8011: {
		title: Test Archive
		unique: false
		side: Shadow
		culture: Sauron
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: [
				shadow
				skirmish
			]
			effect: {
				type: PlayCardFromDiscard
				select: choose(event)
			}
		}
		gametext: <b>Shadow</b> <i>or</i> <b>Skirmish:</b> Play an event from your discard pile.
	}
	0_8012: {
		title: Test Lectern
		unique: false
		side: Shadow
		culture: Sauron
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: [
				shadow
				skirmish
			]
			effect: {
				type: PlayCardFromStacked
				select: choose(event)
				on: self
			}
		}
		gametext: <b>Shadow</b> <i>or</i> <b>Skirmish:</b> Play an event stacked here.
	}
	# CostsAreJudgedInTheOrderPrintedTests: an exertion of a character the player chooses, and then a play from
	# the discard pile of a card that may itself need an exertion.  The real cards that exert a chosen character
	# to play from a discard pile play possessions, minions and conditions, which ask nothing more of him.
	0_8013: {
		title: Test Whetstone
		unique: false
		side: Free Peoples
		culture: Dwarven
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: skirmish
			cost: {
				type: exert
				select: choose(dwarf)
			}
			effect: {
				type: PlayCardFromDiscard
				select: choose(culture(dwarven),event)
			}
		}
		gametext: <b>Skirmish:</b> Exert a Dwarf to play a [dwarven] event from your discard pile.
	}
	# LimitOnADiscountTests: a discount with a printed limit on an ability that can be used more than once in a
	# phase, from hand and from the discard pile.  The one real card of that shape is Uruk Regular's erratum
	# 54_192, which exerts itself each time and so needs its vitality raised to be used twice; the Decipher cards
	# with "(limit -N)" on a twilight cost are events and standing texts.  Test Barrow writes its limit as -2 and
	# Test Muster as 2: a limit is a size, and either is read as "(limit -2)".
	0_8014: {
		title: Test Muster
		unique: false
		side: Shadow
		culture: Sauron
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: [
				shadow
				maneuver
			]
			effect: {
				type: PlayCardFromHand
				select: choose(minion)
				discount: {
					type: cardPhaseLimit
					limit: 2
					amount: {
						type: forEachYouCanSpot
						filter: minion
						multiplier: -1
					}
				}
			}
		}
		gametext: <b>Shadow</b> <i>or</i> <b>Maneuver:</b> Play a minion; its twilight cost is -1 for each minion you can spot (limit -2).
	}
	0_8015: {
		title: Test Barrow
		unique: false
		side: Shadow
		culture: Sauron
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: shadow
			effect: {
				type: PlayCardFromDiscard
				select: choose(minion)
				discount: {
					type: cardPhaseLimit
					limit: -2
					amount: {
						type: forEachYouCanSpot
						filter: minion
						multiplier: -1
					}
				}
			}
		}
		gametext: <b>Shadow:</b> Play a minion from your discard pile; its twilight cost is -1 for each minion you can spot (limit -2).
	}
	# PlacingTheEventPlayedOnADrawDeckTests: a Response that places "that event" (the one whose play it answers)
	# on top of, or beneath, its owner's draw deck, in any phase and for a cost that can always be paid.  The one
	# real text of the kind (Shrouded Elf 13_23 and its erratum 63_23) places the event on top only, for an
	# exertion, in the Elf's own skirmish; no real card places another card's event beneath a draw deck.
	0_8016: {
		title: Test Shelf
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: Response
			trigger: {
				type: played
				filter: your,event
			}
			cost: {
				type: AddTwilight
				amount: 1
			}
			effect: {
				type: PutPlayedEventOnTopOfDrawDeck
				filter: played
			}
		}
		gametext: <b>Response:</b> If you play an event, add (1) to place that event on top of your draw deck.
	}
	0_8017: {
		title: Test Cellar
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: Response
			trigger: {
				type: played
				filter: your,event
			}
			cost: {
				type: AddTwilight
				amount: 1
			}
			effect: {
				type: PutPlayedEventOnBottomOfDrawDeck
				filter: played
			}
		}
		gametext: <b>Response:</b> If you play an event, add (1) to place that event beneath your draw deck.
	}
	# ChoiceWithNothingOnAnyBranchTests: a choice one of whose branches is two effects, the first remembering the
	# cards the second then acts on.  Until that branch is taken nothing is remembered, so it cannot be said
	# beforehand to do nothing, and the question has to be kept.  No real card's choice has a branch that
	# remembers and then acts.
	0_8018: {
		title: Test Fork
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			cost: {
				type: AddTwilight
				amount: 1
			}
			effect: {
				type: choice
				texts: [
					Exert a companion
					Heal each companion
				]
				effects: [
					{
						type: exert
						select: choose(companion)
					}
					[
						{
							type: MemorizeActive
							filter: companion
							memory: toHeal
						}
						{
							type: heal
							select: memory(toHeal)
						}
					]
				]
			}
		}
		gametext: <b>Fellowship:</b> Add (1) to exert a companion or heal each companion.
	}
	# HealBarThatNamesAPlayerTests: a bar on healing that names the player who may not heal.  Every printed
	# "cannot heal" names nobody and stops every heal of the card; the one text that names a player is a Race to
	# Mount Doom modifier (92_35), which lays its bar by a trigger on each heal.  This is the bar by itself.
	0_8019: {
		title: Test Tourniquet
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: modifier
			modifier: {
				type: CantHeal
				filter: minion
				player: you
			}
		}
		gametext: You may not heal minions.
	}
	# StoredValueInATextTests: {stored} in a question that a later action puts, and storeRace.  The one real card
	# whose texts name its stored value (Ulaire Nertea 69_38) names it where its required trigger is described and
	# in a line of the game log; a question put by another action than the one that stored the value is the shape
	# F-0307 was found on, and no card has one now.
	0_8020: {
		title: Test Herald
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: [
			{
				type: Trigger
				optional: false
				trigger: {
					type: played
					filter: self
				}
				effect: [
					{
						type: chooseARace
						memorize: chosenRace
					}
					{
						type: storeRace
						memory: chosenRace
					}
				]
			}
			{
				type: displayableInformation
				text: Named race is {stored}
			}
			{
				type: activated
				phase: fellowship
				effect: {
					type: Optional
					text: Would you like to add (1) for the named race ({stored})?
					effect: {
						type: addTwilight
						amount: 1
					}
				}
			}
		]
		gametext: When you play this condition, name a race.<br><b>Fellowship:</b> You may add (1) for the named race.
	}
	# CanAddBurdensRequirementTests: the requirement canAddBurdens on an action.  The one real card that uses it
	# (Ulaire Nertea 69_38) has it on a standing bar, which only an assignment can read.
	0_8021: {
		title: Test Tally
		unique: false
		side: Free Peoples
		culture: Shire
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: activated
			phase: fellowship
			requires: {
				type: canAddBurdens
			}
			effect: {
				type: addTwilight
				amount: 1
			}
		}
		gametext: <b>Fellowship:</b> If a burden could be added, add (1).
	}
	# FreePeoplesPlayerStartsAssigningTriggerTests: the trigger fpStartedAssigning.  It was made in 2021 for Ulaire
	# Nertea 69_38, which no longer uses it (F-0308: her burden is added at the assignment), and no other card has it.
	0_8022: {
		title: Test Drum
		unique: false
		side: Shadow
		culture: Isengard
		twilight: 0
		type: Condition
		keywords: Support Area
		effects: {
			type: Trigger
			optional: false
			trigger: {
				type: fpStartedAssigning
			}
			effect: {
				type: addTwilight
				amount: 1
			}
		}
		gametext: Each time the Free Peoples player starts to assign minions, add (1).
	}
}
