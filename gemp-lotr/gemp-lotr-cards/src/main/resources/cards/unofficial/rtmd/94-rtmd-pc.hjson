	94_10: {
		cardInfo: {
			//id: 94_10.0
			parent: 94_10
			variant: ORIGINAL
			variantPath: decipher/rtmd
			revision: 0
			image: RTMD/LOTR-EN94S10.0_card.jpg
			collInfo: 94_10
			rarity: _
		}
		title: Race Text 94_10
		type: MetaSite
		intensity: -1
		effects: {
			type: Activated
			phase: skirmish
			requires: [
				{
					type: OwnerIsShadow
				}
				{
					type: CanSpot
					filter: your,minion,damage
				}
			]
			cost: [
				{
					type: ChooseActiveCards
					select: choose(your,minion,damage)
					memorize: damagedMinion
					text: "Choose your minion to make damage -X"
				}
				{
					type: ChooseANumber
					text: "Choose X"
					from: 1
					to: {
						type: ForEachKeyword
						filter: memory(damagedMinion)
						keyword: damage
					}
					memorize: damageAmount
				}
				{
					type: AddKeyword
					select: memory(damagedMinion)
					keyword: damage
					amount: {
						type: FromMemory
						memory: damageAmount
						multiplier: -1
					}
					until: start(regroup)
				}
			]
			effect: {
				type: ModifyStrength
				select: choose(minion,not(memory(damagedMinion)))
				amount: {
					type: FromMemory
					memory: damageAmount
				}
				until: start(regroup)
			}
		}
		gametext: Skirmish: Make your minion damage -X until the regroup phase to make another minion strength +X until the regroup phase.
		lore: ""
		promotext: ""
		helptext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

