{
	94_1: {
		cardInfo: {
			//id: 94_1.0
			parent: 94_1
			variant: ORIGINAL
			variantPath: decipher/rtmd
			revision: 0
			image: RTMD/LOTR-EN94S01.0_card.jpg
			collInfo: 94_1
			rarity: _
		}
		title: Race Text 94_1
		type: MetaSite
		intensity: -3
		effects: {
			type: Activated
			phase: maneuver
			requires: {
				type: OwnerIsFreeps
			}
			cost: {
				type: Exert
				select: choose(your,ally)
				memorize: fightingAlly
			}
			effect: [
				{
					type: EnableParticipationInArcheryFireAndSkirmishes
					select: memory(fightingAlly)
					until: start(regroup)
				}
				{
					type: AddTrigger
					until: endOfTurn
					trigger: {
						type: StartOfPhase
						phase: regroup
					}
					effect: {
						type: Kill
						select: memory(fightingAlly)
					}
				}
			]
		}
		gametext: Maneuver: Exert your ally to allow them to participate in archery fire and skirmishes. At the start of the regroup phase, kill that ally.
		lore: ""
		promotext: ""
		helptext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

