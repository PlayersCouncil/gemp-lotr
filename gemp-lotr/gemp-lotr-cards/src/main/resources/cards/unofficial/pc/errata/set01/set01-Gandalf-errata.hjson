{
	
	# History: 51_70 has one released revision, revision 1 (errata sheet date 2024.04.21, batch "07: 2023 Yuletide"), which is the live block below. It was trial D of four (A to D) put to a vote; the live block was labelled revision 4 after its trial number until 2026-10-05. Trials A to C were never released and are not kept here; they can be read in git at cfa8f0717 (2023-12-16), gemp-lotr/gemp-lotr-cards/src/main/resources/cards/unofficial/pc/errata/yuletide/set01-Gandalf-errata-playtest.hjson (71_70, 71_402 and the first 71_403; the second 71_403 is trial D).
		51_70: {
		cardInfo: {
			//id: 51_70.1
			parent: 1_70
			variant: ERRATA
			variantPath: errata/pc
			revision: 1
			image: errata/LOTR-EN01E070.1_card.jpg
			collInfo: 1U70
			rarity: U
		}
		title: Barliman Butterbur
		subtitle: Prancing Pony Proprietor
		unique: true
		side: Free Peoples
		culture: Gandalf
		twilight: 1
		type: Ally
		allyHome: 1F
		race: Man
		strength: 1
		vitality: 2
		effects: {
			type: activated
			phase: fellowship
			cost: {
				type: exert
				select: self
			}
			effect: {
				type: putCardsFromDiscardIntoHand
				select: choose(spell)
			}
		}
		gametext: <b>Fellowship:</b> Exert Barliman Butterbur to take a spell into hand from your discard pile.
		lore: "'You don't know much even about them, if you think old Barliman is stupid,' said Gandalf. 'He is wise enough on his own ground.'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

