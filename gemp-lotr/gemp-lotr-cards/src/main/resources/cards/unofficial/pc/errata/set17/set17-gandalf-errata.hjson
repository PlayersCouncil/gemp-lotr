{
	67_15: {
		cardInfo: {
			//id: 67_15.1
			parent: 17_15
			variant: ERRATA
			variantPath: errata/pc
			revision: 1
			image: errata/LOTR-EN17E015.1.jpg
			collInfo: 17U15
			rarity: U
		}
		title: A New Light
		unique: false
		culture: gandalf
		twilight: 1
		type: event
		timeword: fellowship
		keyword: [
			spell
		]
		effects: [
			{
				type: event
				requires: {
					type: canSpot
					filter: culture(gandalf),wizard
				}
				effect: [
					{
						type: PutCardsFromDiscardIntoHand
						player: freeps
						discard: shadow
						select: choose(minion)
						count: 2
						memorize: chosenMinions
					}
					{
						type: If
						check: {
							type: IsGreaterThan
							firstNumber: {
								type: ForEachInMemory
								memory: chosenMinions
							}
							secondNumber: 1
						}
						true: [
							{
								type: revealHand
								hand: shadowPlayer
								memorize: revealedCards
							}
							{
								type: discardFromHand
								hand: shadowPlayer
								forced: true
								player: you
								select: choose(memory(revealedCards),minion)
							}
						]
					}
				]
			}
		]
		
		gametext: <b>Spell.</b> Spot a [gandalf] Wizard to search a Shadow player's discard pile and choose 2 minions, then return those minions to their owner's hand. If you do, reveal that hand and discard a revealed minion.
		lore: "'I once knew every spell in all the tongues of Men or Elves or Orcs...'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}
	
