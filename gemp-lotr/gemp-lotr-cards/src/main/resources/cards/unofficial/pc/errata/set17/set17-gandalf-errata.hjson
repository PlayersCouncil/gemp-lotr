	67_24: {
		cardInfo: {
			//id: 67_24.2
			parent: 17_24
			variant: ERRATA
			variantPath: errata/pc
			revision: 2
			image: errata/LOTR-EN17E024.1_card.jpg
			collInfo: 17R24
			rarity: R
		}
		title: Shadowfax
		subtitle: Greatest of the Mearas
		unique: true
		side: Free Peoples
		culture: Gandalf
		twilight: 2
		type: Possession
		strength: 1
		vitality: 1
		resistance: 1
		itemclass: Mount
		target: culture(gandalf),wizard
		effects: [
			{
				type: Trigger
				optional: false
				trigger: {
					type: ConstantlyCheck
				}
				requires: {
					type: canSpot
					filter: another,or(possession,weapon),attachedTo(bearer)
				}
				effect: {
					type: discard
					select: all(other,or(possession,weapon),attachedTo(bearer))
				}
			}
			{
				type: Trigger
				optional: true
				trigger: {
					type: Moves
				}
				cost: [
					{
						type: exert
						select: bearer
						times: 1				
					}
					{
						type: AddThreats
						amount: 1
					}
				]
				effect: {
					type: RemoveBurdens
					amount: 1
				}
			}
		]
		gametext: Bearer must be a [gandalf] Wizard.<br>Discard all other possessions and weapons on bearer.<br>Each time the fellowship moves, you may exert bearer and add a threat to remove a burden.
		lore: "There are no horses like those that are bred in that great vale between the Misty Mountains and the White."
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}
}