{
	33_55: {
		cardInfo: {
			image: hobbit/HDG3355.jpg
			collInfo: 33_55
			rarity: _
		}
		title: Prancing Pony
		unique: false
		twilight: 0
		type: site
		block: hobbit
		site: 1
		effects: {
			type: Trigger
			optional: true
			trigger: {
				type: startOfPhase
				phase: fellowship
			}
			// A Hobbit-set take from the draw deck with nothing to take is withheld (Q-0019; the orchestrator on
			// Q-0406 and Q-0418): asked before the cost, as Old Thrush 31_42 has it.
			requires: [
				{
					type: isSide
					side: free people
				}
				{
					type: hasCardInDrawDeck
					filter: or(culture(gandalf),culture(shire))
				}
			]
			cost: {
				type: addTwilight
				amount: 2
			}
			effect: {
				type: putCardsFromDeckIntoHand
				select: choose(or(culture(gandalf),culture(shire)))
				reveal: true
				shuffle: true
				showAll: true
			}
		}
		gametext: At the start of your fellowship phase, you may add (2) to take a [gandalf] or [shire] card into hand from your draw deck.
		lore: ""
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

