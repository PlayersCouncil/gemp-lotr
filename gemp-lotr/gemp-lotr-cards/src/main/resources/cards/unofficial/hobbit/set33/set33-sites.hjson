	33_58: {
		cardInfo: {
			image: hobbit/HDG3358.jpg
			collInfo: 33_58
			rarity: _
		}
		title: Front Gate of Erebor
		unique: false
		twilight: 8
		type: site
		block: hobbit
		site: 7
		keywords: [
			mountain
			river
		]
		effects: {
			type: Trigger
			optional: false
			trigger: {
				type: startOfPhase
				phase: maneuver
			}
			requires: [
				{
					type: canSpot
					filter: culture(dwarven),follower
				}
				{
					type: canSpot
					filter: culture(dwarven),companion
				}
			]
			effect: [
				{
					type: chooseYesOrNo
					player: fp
					text: Would you like to transfer a Dwarven follower to a Dwarven companion for free?
					memorize: choice
				}
				{
					type: choice
					player: fp
					texts: [
						This is just a hack to allow this card to break the rules
					]
					effects: [
						{
							type: If
							check: {
								type: memoryIs
								memory: choice
								value: yes
							}
							true: [
								{
									type: transfer
									select: choose(culture(dwarven),follower)
									where: choose(culture(dwarven),companion)
									memorizeTransferred: transferredFollowers
								}
								{
									type: repeat
									times: {
										type: forEachYouCanSpot
										filter: follower,culture(dwarven),not(memory(transferredFollowers))
									}
									effect: {
										type: If
										check: {
											type: memoryIs
											memory: choice
											value: yes
										}
										true: [
											{
												type: chooseYesOrNo
												text: Would you like to transfer another follower for free?
												memorize: choice
											}
											{
												type: If
												check: {
													type: memoryIs
													memory: choice
													value: yes
												}
												true: [
													{
														type: transfer
														select: choose(culture(dwarven),follower,not(memory(transferredFollowers)))
														where: choose(culture(dwarven),companion)
														memorizeTransferred: anotherTransferredFollower
													}
													{
														type: memorize
														filter: or(memory(transferredFollowers),memory(anotherTransferredFollower))
														memory: transferredFollowers
													}
												]
											}
										]
									}
								}
								{
									type: addModifier
									modifier: {
										type: cantBeTransferred
										filter: memory(transferredFollowers)
									}
								}
							]
						}
					]
				}
			]
		}
		gametext: <b>Mountain</b>. <b>River</b>. [dwarven] followers may be attached to [dwarven] companions without paying the aid cost.
		lore: ""
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}
}
