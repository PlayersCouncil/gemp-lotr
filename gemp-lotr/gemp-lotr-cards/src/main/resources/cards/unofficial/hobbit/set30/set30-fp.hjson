{
	30_1: {
		cardInfo: {
			image: hobbit/HDG301.jpg
			collInfo: 30_1
			rarity: _
		}
		title: Ancestral Knowledge
		unique: false
		side: Free Peoples
		culture: dwarven
		twilight: 2
		type: event
		timewords: maneuver
		effects: {
			type: event
			cost: {
				type: exert
				select: choose(dwarf,character)
			}
			effect: {
				type: discard
				select: choose(condition)
				count: {
					type: Conditional
					requires: {
						type: canSpot
						filter: side(shadow),condition
						count: 4
					}
					true: 2
					false: 1
				}
			}
		}
		gametext: Exert a Dwarf character to discard a condition (or 2 conditions if you can spot 4 Shadow conditions).
		lore: "'If more of us valued food and cheer and song above hoarded gold, it would be a merrier world.'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

