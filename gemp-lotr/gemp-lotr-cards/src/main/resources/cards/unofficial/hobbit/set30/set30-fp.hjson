		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	30_3: {
		cardInfo: {
			image: hobbit/HDG303.jpg
			collInfo: 30_3
			rarity: _
		}
		title: Battle Fury
		unique: false
		side: Free Peoples
		culture: dwarven
		twilight: 1
		type: event
		timewords: skirmish
		effects: {
			type: event
			effect: {
				type: modifyStrength
				select: choose(dwarf,character)
				memorize: chosenDwarf
				amount: {
					type: Conditional
					requires: {
						type: memoryMatches
						memory: chosenDwarf
						filter: hasAttached(culture(dwarven),follower)
					}
					true: 4
					false: 3
				}
			}
		}
		gametext: Make a Dwarf character strength +3 (or +4 if he bears a [dwarven] follower).
		lore: "The Dwarves quickly dispatch Orcs with their mighty battle axes."
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	30_4: {
		cardInfo: {
			image: hobbit/HDG304.jpg
			collInfo: 30_4
			rarity: _
		}
		title: Battle of Azanulbizar
		unique: false
		side: Free Peoples
		culture: dwarven
		twilight: 0
		type: event
		timewords: maneuver
		effects: {
			type: event
			cost: {
				type: exert
				select: choose(dwarf,character)
			}
			effect: {
				type: choice
				texts: [
					Wound 2 Orcs
					Wound 1 Orc twice
				]
				effects: [
					{
						type: wound
						select: choose(orc)
						count: 2
					}
					{
						type: wound
						select: choose(orc)
						times: 2
					}
				]
			}
		}
		gametext: Exert a Dwarf character to wound 2 Orcs or to wound 1 Orc twice.
		lore: "It was the greatest battle of the War of Dwarves and Orcs, and was a decisive victory for the Dwarves."
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

