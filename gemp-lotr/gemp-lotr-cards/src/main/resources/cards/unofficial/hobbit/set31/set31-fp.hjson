		title: Dwarven Axe
		unique: false
		side: Free Peoples
		culture: dwarven
		twilight: 1
		type: possession
		itemclass: hand weapon
		strength: 2
		target: culture(dwarven),character
		effects: {
			type: modifier
			modifier: {
				type: addKeyword
				filter: bearer,atSite(mountain)
				keyword: damage+1
			}
		}
		gametext: Bearer must be a [dwarven] character.<br>While bearer is at a mountain site, he is <b>damage +1</b>.
		lore: "'Buckler and corslet, axe and sword / And shining spears were laid in hoard.'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	31_2: {
		cardInfo: {
			image: hobbit/HDG312.jpg
			collInfo: 31_2
			rarity: _
		}
		title: Dwarven Song
		unique: false
		side: Free Peoples
		culture: dwarven
		twilight: 3
		type: event
		timewords: fellowship
		effects: {
			type: event
			// At sites 1 to 5 it is played only with a [dwarven] card (except an event) that can be played from the
			// draw deck: a Hobbit-set play from the draw deck with nothing it could play is withheld (Q-0019; the
			// orchestrator on Q-0406 and Q-0418).  The play sits in an If, which does not gate the event itself.
			requires: {
				type: or
				requires: [
					{
						type: location
						filter: not(siteNumber(1-5),siteBlock(hobbit))
					}
					{
						type: playable
						fromZone: DECK
						filter: culture(dwarven),not(event)
					}
				]
			}
			cost: {
				type: choice
				texts: [
					Sites 1-5
					Sites 6-9
				]
				effects: [
					{
						type: If
						check: {
							type: location
							filter: siteNumber(1-5),siteBlock(hobbit)
						}
						true: {
							type: discard
							select: choose(culture(dwarven),follower)
							memorize: discardedFollower
						}
					}
					{
						type: If
						check: {
							type: location
							filter: not(siteNumber(1-5),siteBlock(hobbit))
						}
					}
				]
			}
			effect: [
				{
					type: If
					check: {
						type: location
						filter: siteNumber(1-5),siteBlock(hobbit)
					}
					true: {
						type: repeat
						times: {
							type: twilightCostInMemory
							memory: discardedFollower
						}
						effect: {
							type: playCardFromDrawDeck
							select: choose(culture(dwarven),not(event))
							showAll: true
							shuffle: true
						}
					}
				}
				{
					type: If
					check: {
						type: location
						filter: not(siteNumber(1-5),siteBlock(hobbit))
					}
					true: {
						type: heal
						select: choose(name(Thorin))
						times: 2
					}
				}
			]
		}
		gametext: At sites 1 to 5, discard a [dwarven] follower with a twilight cost of X to play X [dwarven] cards (except events) from your draw deck. At any other site, heal Thorin twice.
		lore: "'Far over the misty mountains cold. To dungeons deep and caverns old...'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	31_3: {
		cardInfo: {
			image: hobbit/HDG313.jpg
			collInfo: 31_3
			rarity: _
		}
		title: Emeralds of Girion
		unique: true
		side: Free Peoples
		culture: dwarven
		twilight: 2
		type: artifact
		keywords: support area
		effects: [
			{
				type: activated
				phase: fellowship
				cost: {
					type: addTwilight
					amount: 1
				}
				effect: {
					type: putStackedCardsIntoHand
					select: choose(any)
					on: self
				}
			}
			{
				type: activated
				phase: regroup
				cost: {
					type: exert
					select: choose(culture(elven),ally)
				}
				effect: {
					type: stackCardsFromDiscard
					select: choose(or(and(culture(elven),event),name(Lore of Imladris)))
					where: self
				}
			}
		]
		gametext: <b>Fellowship:</b> Add (1) to take a card stacked here into hand.<br><b>Regroup:</b> Exert an [elven] ally to stack an [elven] event (or Lore of Imladris) from your discard pile on Emeralds of Girion.
		lore: "'The Necklace of Girion, Lord of Dale, made of five hundred emeralds green as grass...'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	31_4: {
		cardInfo: {
			image: hobbit/HDG314.jpg
			collInfo: 31_4
			rarity: _
