		title: Great Barricade
		unique: true
		side: Free Peoples
		culture: dwarven
		twilight: 2
		type: possession
		keywords: [
			support area
			fortification
		]
		effects: [
			{
				type: extraCost
				cost: {
					type: exert
					select: choose(culture(dwarven),companion)
				}
			}
			{
				type: Trigger
				optional: false
				trigger: {
					type: moves
				}
				requires: {
					type: phase
					phase: regroup
				}
				effect: {
					type: discard
					select: self
				}
			}
			{
				type: modifier
				modifier: {
					type: modifyStrength
					filter: minion,inSkirmishAgainst(culture(dwarven),companion)
					requires: {
						type: location
						filter: siteNumber(7-8)
					}
					amount: -3
				}
			}
		]
		gametext: <b>Fortification</b>. To play, exert a [dwarven] companion.<br>If the fellowship moves during the regroup phase, discard this possession.<br>At sites 7 and 8, each minion skirmishing a [dwarven] companion is strength -3.
		lore: "Thorin barricades himself in the mountain."
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

