	30_66: {
		cardInfo: {
			image: hobbit/HDG3066.jpg
			collInfo: 30_66
			rarity: _
		}
		title: Smaug
		subtitle: The Golden
		unique: true
		side: Shadow
		culture: smaug
		twilight: 16
		type: minion
		race: dragon
		strength: 17
		vitality: 5
		site: 7
		keywords: [
			damage+2
			fierce
		]
		effects: [
			{
				type: Trigger
				optional: false
				trigger: {
					type: ConstantlyCheck
					requires: {
						type: location
						filter: not(mountain)
					}
				}
				effect: {
					type: discard
					select: self
				}
			}
			{
				type: modifyOwnCost
				amount: {
					type: forEachYouCanSpot
					filter: or(dwarf,man,elf)
					multiplier: -1
				}
			}
			{
				type: activated
				phase: regroup
				cost: [
					{
						type: exert
						select: self
					}
					{
						type: discard
						select: choose(another,minion)
					}
				]
				effect: {
					type: discard
					select: choose(side(free people),not(or(companion,name(Bard),ring)))
				}
			}
		]
		gametext: <b>Damage +2</b>. <b>Fierce</b>.<br>Discard Smaug if not at a mountain.<br>For each Dwarf, Man and Elf you spot, Smaug's twilight cost is -1.<br><b>Regroup:</b> Exert Smaug and discard another minion to discard a Free Peoples card (except a companion, Bard or a Ring).
		lore: ""
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}
