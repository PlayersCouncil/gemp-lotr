{
	30_32: {
		cardInfo: {
			image: hobbit/HDG3032.jpg
			collInfo: 30_32
			rarity: _
		}
		title: Anger
		unique: false
		side: Shadow
		culture: gundabad
		twilight: 1
		type: event
		timewords: skirmish
		effects: {
			type: event
			effect: {
				type: modifyStrength
				select: choose(minion)
				memorize: chosenMinion
				amount: {
					type: Conditional
					requires: {
						type: memoryMatches
						memory: chosenMinion
						filter: inSkirmishAgainst(hasAttached(follower))
					}
					true: 4
					false: 2
				}
			}
		}
		gametext: Make a minion strength +2 (or +4 if skirmishing a character bearing a follower).
		lore: "'Out jumped the goblins, big goblins, great ugly-looking goblins, lots of goblins, before you could say rocks and blocks.'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	30_33: {
		cardInfo: {
			image: hobbit/HDG3033.jpg
			collInfo: 30_33
			rarity: _
		}
		title: Fimbul
		subtitle: Orkish Assassin
		unique: true
		side: Shadow
		culture: gundabad
		twilight: 2
		type: minion
		race: orc
		strength: 7
		vitality: 2
		site: 3
		keywords: damage+1
		effects: [
			{
				type: extraCost
				cost: {
					type: exert
					select: choose(orc)
				}
			}
			{
				type: activated
				phase: shadow
				cost: {
					type: discard
					select: self
				}
				effect: {
					type: playCardFromDrawDeck
					select: choose(minion)
					showAll: true
					shuffle: true
					mustExist: true
				}
			}
		]
		gametext: <b>Damage +1</b>. To play, exert an Orc.<br><b>Shadow:</b> Discard Fimbul from play to play a minion from your draw deck.
		lore: "His strong will and keen senses were only surpassed by his burning hatred for Dwarves."
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

