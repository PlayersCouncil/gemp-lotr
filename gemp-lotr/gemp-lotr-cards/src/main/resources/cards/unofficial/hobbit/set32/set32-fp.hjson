	32_8: {
		cardInfo: {
			image: hobbit/HDG328.jpg
			collInfo: 32_8
			rarity: _
		}
		title: Roäc
		subtitle: Son of Carc
		unique: true
		side: Free Peoples
		culture: dwarven
		twilight: 1
		type: follower
		race: bird
		strength: 1
		effects: [
			{
				type: aidCost
				cost: {
					type: exert
					select: choose(name(Thorin))
				}
			}
			{
				type: activated
				phase: maneuver
				// With no [dwarven] ally to play from the draw deck nor to allow, neither branch can do anything and
				// Roäc is not discarded for nothing: a Hobbit-set play from the draw deck with nothing it could play is
				// withheld (Q-0019; the orchestrator on Q-0406 and Q-0418), as Old Thrush 31_42's take is.
				requires: [
					{
						type: canSpot
						filter: self,attachedTo(any)
					}
					{
						type: or
						requires: [
							{
								type: canSpot
								filter: culture(dwarven),ally
							}
							{
								type: playable
								fromZone: DECK
								filter: culture(dwarven),ally
							}
						]
					}
				]
				cost: {
					type: discard
					select: self
				}
				effect: {
					type: choice
					texts: [
						Play a DWARVEN ally from your draw deck
						Allow a DWARVEN ally to participate in skirmishes until the regroup phase
					]
					effects: [
						{
							type: playCardFromDrawDeck
							select: choose(culture(dwarven),ally)
							showAll: true
							shuffle: true
							mustExist: true
						}
						{
							type: EnableParticipationInSkirmishes
							select: choose(culture(dwarven),ally)
							until: start(regroup)
						}
					]
				}
			}
		]
		gametext: <b>Aid</b> – Exert Thorin.<br><b>Maneuver:</b> If Roac is attached, discard him to play a [dwarven] ally from your draw deck, or to allow a [dwarven] ally to participate in skirmishes until the regroup phase.
		lore: "The treasure is likely to be your death."
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

