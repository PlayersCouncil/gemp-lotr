{
	32_1: {
		cardInfo: {
			image: hobbit/HDG321.jpg
			collInfo: 32_1
			rarity: _
		}
		title: Crown of Erebor
		unique: true
		side: Free Peoples
		culture: dwarven
		twilight: 2
		type: artifact
		keywords: support area
		effects: [
			{
				// Q-0414 (on Q-0314): "Then" begins a separate effect with a "may" of its own, so the trigger is
				// required, the heal a choice of 0 to 1 and the doubt removal its own 0 to 1 after it.
				type: Trigger
				optional: false
				trigger: {
					type: played
					filter: your,name(Roäc)
				}
				effect: [
					{
						type: heal
						select: choose(or(name(Thorin),name(Dain Ironfoot)))
						count: 0-1
					}
					{
						type: optional
						text: Would you like to remove a doubt?
						requires: {
							type: canSpotBurdens
						}
						effect: {
							type: removeBurdens
							amount: 1
						}
					}
				]
			}
			{
				type: activated
				phase: assignment
				requires: {
					type: cantSpot
					filter: name(Thorin)
				}
				effect: {
					type: EnableParticipationInSkirmishes
					select: all(culture(dwarven),ally)
				}
			}
		]
		gametext: Each time you play Roäc, you may heal Thorin or Dain Ironfoot. Then, you may remove a doubt.<br><b>Assignment:</b> If you cannot spot Thorin, [dwarven] allies may be assigned to skirmishes.
		lore: "Dain has crowned their chief with gold, and sworn friendship with them for ever."
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

