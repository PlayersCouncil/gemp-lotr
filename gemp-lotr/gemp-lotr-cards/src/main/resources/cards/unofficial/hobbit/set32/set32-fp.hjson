		culture: dwarven
		twilight: 3
		type: ally
		allyHome: 9H
		race: dwarf
		strength: 9
		vitality: 3
		keywords: damage+1
		effects: {
			type: activated
			phase: maneuver
			requires: {
				type: isGreaterThan
				firstNumber: {
					type: forEachYouCanSpot
					filter: minion
				}
				secondNumber: {
					type: forEachYouCanSpot
					filter: companion
				}
			}
			cost: [
				{
					type: exert
					select: self
				}
				{
					type: discard
					select: choose(culture(dwarven),follower)
				}
			]
			effect: {
				type: discard
				player: shadowPlayer
				select: choose(minion)
			}
		}
		gametext: <b>Damage +1</b>.<br><b>Maneuver:</b> If you can spot more minions than companions, exert Iron Hills Army and discard a [dwarven] follower to make an opponent discard a minion.
