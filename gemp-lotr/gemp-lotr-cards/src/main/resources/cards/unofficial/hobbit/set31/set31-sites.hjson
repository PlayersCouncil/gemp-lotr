{
	31_44: {
		cardInfo: {
			image: hobbit/HDG3144.jpg
			collInfo: 31_44
			rarity: _
		}
		title: Beorn's House
		unique: false
		type: site
		block: hobbit
		site: 4
		twilight: 4
		effects: {
			type: activated
			phase: fellowship
			cost: {
				type: choice
				texts: [
					Spot a GANDALF staff
					Play a GANDALF staff from your draw deck
				]
				effects: [
					{
						type: spot
						filter: culture(gandalf),staff
					}
					{
						type: playCardFromDrawDeck
						select: choose(culture(gandalf),staff)
						showAll: true
						shuffle: true
						mustExist: true
					}
				]
			}
			effect: [
				{
					type: spot
					text: Choose a Gandalf
					select: choose(name(Gandalf))
					memorize: chosenGandalf
				}
				{
					type: addModifier
					modifier: {
						type: cantBeDiscarded
						filter: memory(chosenGandalf)
					}
					until: endOfTurn
				}
			]
		}
		gametext: <b>Fellowship:</b> Spot a [gandalf] staff or play it from your draw deck to prevent Gandalf from being discarded until the end of turn.
		lore: ""
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

