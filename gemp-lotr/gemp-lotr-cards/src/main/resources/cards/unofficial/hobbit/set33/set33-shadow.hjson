	33_30: {
		cardInfo: {
			image: hobbit/HDG3330.jpg
			collInfo: 33_30
			rarity: _
		}
		title: Borders of the Forest
		unique: false
		side: Shadow
		culture: mirkwood
		twilight: 1
		type: condition
		keywords: support area
		effects: [
			{
				type: Trigger
				optional: true
				trigger: {
					type: endOfPhase
					phase: shadow
				}
				requires: {
					type: canSpot
					filter: culture(gundabad),orc
				}
				effect: {
					type: heal
					select: choose(culture(gundabad),orc)
				}
			}
			{
				type: activated
				phase: assignment
				requires: [
					{
						type: location
						filter: forest
					}
					{
						type: canSpot
						filter: culture(gundabad),orc,assignableToSkirmishAgainst(name(Bilbo))
					}
				]
				effect: {
					type: assignFpCharacterToSkirmish
					fpCharacter: choose(name(Bilbo))
					minion: choose(culture(gundabad),orc,assignableToSkirmishAgainst(name(Bilbo)))
					memorizeFPCharacter: bilbo
					memorizeMinion: chosenMinion
					preventText: Would you like to add a burden and assign {chosenMinion} to prevent assigning Bilbo to that minion?
					preventCost: {
						type: addBurdens
					}
					insteadEffect: {
						type: assignFpCharacterToSkirmish
						player: free people
						fpCharacter: choose(any)
						minion: choose(memory(chosenMinion))
					}
				}
			}
		]
		gametext: At the end of your Shadow phase, you may heal a [gundabad] Orc.<br><b>Assignment:</b> At a forest, assign a [gundabad] Orc to skirmish Bilbo. The Free Peoples player may add a doubt to prevent this and assign that Orc.
		lore: ""
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

