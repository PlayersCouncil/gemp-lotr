	33_32: {
		cardInfo: {
			image: hobbit/HDG3332.jpg
			collInfo: 33_32
			rarity: _
		}
		title: Elven Jails
		unique: false
		side: Shadow
		culture: mirkwood
		twilight: 2
		type: condition
		keywords: support area
		effects: [
			{
				type: activated
				phase: regroup
				cost: [
					{
						type: discard
						select: choose(culture(gundabad),orc)
					}
					{
						type: removeTwilight
						amount: 4
					}
				]
				effect: {
					type: StackCardsFromPlay
					select: choose(lowestStrength(culture(dwarven),companion))
					where: self
				}
			}
			{
				type: Trigger
				optional: false
				trigger: {
					type: aboutToDiscard
					filter: self
				}
				effect: [
					{
						type: memorizeStacked
						on: self
						memory: jailedCards
					}
					{
						type: addTrigger
						trigger: {
							type: discarded
							filter: self
						}
						effect: [
							{
								type: choice
								player: fp
								texts: [
									The Free Peoples player takes stacked cards into hand
								]
								effects: [
									{
										type: putCardsFromDiscardIntoHand
										select: choose(memory(jailedCards))
										count: {
											type: forEachInMemory
											memory: jailedCards
										}
									}
								]
							}
						]
					}
				]
			}
		]
		gametext: When this condition is discarded, cards stacked here return to their owner's hand.<br><b>Regroup:</b> Discard a [gundabad] Orc from play and remove (4) to stack a [dwarven] companion with the lowest strength here.
		lore: "'There is no escape from my magic doors.'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

