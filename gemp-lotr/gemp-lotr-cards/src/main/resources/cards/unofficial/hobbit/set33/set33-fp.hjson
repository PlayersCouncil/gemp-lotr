		culture: dwarven
		twilight: 1
		type: possession
		keywords: support area
		effects: [
			{
				type: Trigger
				optional: true
				trigger: {
					type: played
					filter: or(name(bifur),name(bofur),name(bombur))
				}
				effect: {
					type: AddCultureTokens
					culture: dwarven
					select: self
				}
			}
			{
				type: activated
				phase: [
					fellowship
					regroup
				]
				cost: {
					type: RemoveCultureTokens
					culture: dwarven
					select: self
				}
				limitPerPhase: 1
				effect: {
					type: putCardsFromDiscardIntoHand
					select: choose(culture(dwarven),event,minTwilight(1),maxTwilight(1))
				}
			}
		]
		gametext: Each time you play Bifur, Bofur or Bombur, you may place a [dwarven] token here.<br><b>Fellowship or Regroup:</b> Remove a [dwarven] token from here to take a [dwarven] event with a twilight cost of 1 into hand from your discard pile (limit once per phase).
		lore: "'Cheese knife? He eats it by the block...'"
		promotext: ""
		alts: {
			promos: {
