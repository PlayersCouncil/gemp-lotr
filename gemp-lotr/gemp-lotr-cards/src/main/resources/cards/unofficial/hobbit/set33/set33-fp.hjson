{
	33_1: {
		cardInfo: {
			image: hobbit/HDG331.jpg
			collInfo: 33_1
			rarity: _
		}
		title: The Ancient Forges
		unique: true
		side: Free Peoples
		culture: dwarven
		twilight: 2
		type: possession
		keywords: [
			support area
			fortification
		]
		effects: [
			{
				type: extraCost
				cost: {
					type: exert
					select: choose(culture(dwarven),companion)
				}
			}
			{
				type: modifier
				modifier: {
					type: modifyStrength
					filter: name(Balin)
					requires: {
						type: location
						filter: siteNumber(7-8)
					}
					amount: 2
				}
			}
			{
				type: activated
				phase: skirmish
				requires: {
					type: location
					filter: siteNumber(8)
				}
				cost: [
					{
						type: exert
						select: choose(name(Balin))
					}
					{
						type: discard
						select: choose(culture(dwarven),fortification)
					}
				]
				effect: {
					type: wound
					select: choose(minion)
					times: 2
				}
			}
		]
		gametext: <b>Fortification</b>. To play, exert a [dwarven] companion.<br>At sites 7 and 8, Balin is strength +2.<br><b>Skirmish:</b> At site 8, exert Balin and discard a [dwarven] fortification to wound a minion twice.
		lore: "'Lead him to the forges. We kill the dragon.'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	33_2: {
		cardInfo: {
			image: hobbit/HDG332.jpg
			collInfo: 33_2
			rarity: _
		}
		title: At your Service!
		unique: false
		side: Free Peoples
		culture: dwarven
		twilight: 2
		type: event
		timewords: fellowship
		effects: {
			type: event
			cost: [
				{
					type: exert
					select: choose(name(Bilbo))
				}
				{
					type: addBurdens
					amount: 1
				}
			]
			effect: {
				type: playCardFromDrawDeck
				select: choose(culture(dwarven),or(possession,follower))
				showAll: true
				shuffle: true
				mustExist: true
			}
		}
		gametext: Exert Bilbo and add a doubt to play a [dwarven] possession or a [dwarven] follower from your draw deck.
		lore: "'At your service!'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	33_3: {
		cardInfo: {
			image: hobbit/HDG333.jpg
			collInfo: 33_3
			rarity: _
		}
		title: Balin's Armor
		unique: true
		side: Free Peoples
		culture: dwarven
		twilight: 1
		type: possession
		itemclass: armor
		vitality: 1
		target: name(Balin)
		effects: [
			{
				type: Trigger
				optional: true
				trigger: {
					type: winsSkirmish
					filter: name(Bilbo)
				}
				effect: {
					type: heal
					select: choose(name(Balin))
				}
			}
			{
				type: activated
				phase: fellowship
				// A Hobbit-set take from the draw deck with nothing to take is withheld (Q-0019; the orchestrator on
				// Q-0406 and Q-0418): asked before the cost, as Old Thrush 31_42 has it.
				requires: {
					type: hasCardInDrawDeck
					filter: culture(dwarven),timeword(skirmish),event
				}
				cost: {
					type: exert
					select: choose(name(Balin))
				}
				effect: {
					type: putCardsFromDeckIntoHand
					select: choose(culture(dwarven),timeword(skirmish),event)
					reveal: true
					shuffle: true
					showAll: true
				}
			}
		]
		gametext: Bearer must be Balin.<br>Each time Bilbo wins a skirmish, you may heal Balin.<br><b>Fellowship:</b> Exert Balin to take a [dwarven] skirmish event into hand from your draw deck.
		lore: "'...for there was no hauberk...'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	33_4: {
		cardInfo: {
			image: hobbit/HDG334.jpg
			collInfo: 33_4
			rarity: _
		}
		title: Blunt The Knives!
		unique: false
		side: Free Peoples
		culture: dwarven
		twilight: 0
		type: event
		timewords: fellowship
		effects: {
			type: event
			effect: {
				type: choice
				texts: [
					Draw 2 cards
					Play Balin from your draw deck
					Place 2 cards from discard beneath your deck
				]
				effects: [
					{
						type: drawCards
						count: 2
					}
					{
						type: playCardFromDrawDeck
						select: choose(name(Balin))
						showAll: true
						shuffle: true
						mustExist: true
					}
					{
						type: putCardsFromDiscardOnBottomOfDeck
						count: 2
					}
				]
			}
		}
		gametext: Choose one: draw 2 cards; play Balin from your draw deck; or place 2 cards from your discard pile beneath your draw deck.
		lore: "'And when you have finished, if any are whole, Send them down the hall to roll!'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

	33_5: {
		cardInfo: {
			image: hobbit/HDG335.jpg
			collInfo: 33_5
