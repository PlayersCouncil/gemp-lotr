	33_8: {
		cardInfo: {
			image: hobbit/HDG338.jpg
			collInfo: 33_8
			rarity: _
		}
		title: Eager To Brawl
		unique: false
		side: Free Peoples
		culture: dwarven
		twilight: 1
		type: event
		timewords: response
		effects: {
			type: responseEvent
			requires: [
				{
					type: canSpot
					filter: culture(dwarven),follower
				}
				{
					type: phase
					phase: regroup
				}
			]
			trigger: {
				type: moves
			}
			cost: {
				type: spot
				select: choose(culture(dwarven),follower)
				memorize: spottedFollower
			}
			effect: [
				{
					type: addTwilight
					amount: {
						type: twilightCostInMemory
						memory: spottedFollower
					}
				}
				{
					type: discard
					select: choose(minion,not(name(Smaug)))
					count: {
						type: range
						from: 0
						to: {
							type: twilightCostInMemory
							memory: spottedFollower
						}
					}
				}
			]
		}
		gametext: If the fellowship moves during the regroup phase, spot a [dwarven] follower with a twilight cost of X and add (X) to discard up to X minions (except Smaug).
		lore: "'Go Bombur! Go!'"
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

