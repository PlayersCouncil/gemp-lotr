{
	# Tutorial 1.  The messages are ketura's script as she wrote it, except where a comment says otherwise:
	#     # CHANGED         a message of hers that was altered; the comment says how, and why
	#     # NEW (Claude)    a message that is not hers: the script was silent there, or had not got that far
	# Numbers in the messages are filled in from the game ({strength:frodo}, {twilight}) wherever one can be, so
	# that a card being swapped cannot leave a sentence untrue.
	#
	# To read every message with its numbers filled in, beside the decisions the game asks around it:
	#     mvn test -pl gemp-lotr-server -Dtest=ScenarioCanonTest -DargLine="-Dscenario.explore=basics-01"
	# (add -Dscenario.choose=plan inside the quotes for the "I have a plan" way through the last turn)
	id: basics-01-into-the-wild
	version: 1
	kind: tutorial
	title: Into the Wild
	summary: Frodo sets out alone across four sites. Learn the phases of a turn, twilight, skirmishes and overwhelming, events, sanctuaries, and how to keep a fellowship alive.
	author: ketura
	tags: basics, phases, twilight, archery, assignment, skirmish, overwhelm, events, sanctuary, defender
	format: scenario
	human: freeps
	opponent: {
		name: The Shadow
		fallback: pass
		# Standing orders: what the opponent does with a decision that no step covers.  These two make it play its
		# second Drums in the Deep on the Chieftain when Gandalf fights him on turn 3, whichever order the player
		# takes the skirmishes in.
		orders: [
			{
				when: {
					decision: action
					phase: skirmish
					turn: 3
					require: {
						type: canSpot
						filter: alias(gandalf),inSkirmish
					}
				}
				answer: play(drums2)
			}
			{
				when: opponent, cards, phase(skirmish), turn(3)
				answer: choose(chieftain)
			}
		]
	}
	coverage: strict
	options: {
		# The player is passed through these phases when there is nothing to play, EXCEPT where a step below is
		# about that very pass (turn 1's archery phase).
		autoPass: archery, assignment, regroup
	}

	cards: {
		# The order here is the order of the deck, and so the order things are drawn in.
		freeps: {
			# Frodo, Resolute Hobbit: strength 3, vitality 4, no text
			frodo: 10_121
			# The One Ring, The Ruling Ring: strength +1, text switched off in 'rules'
			ring: 1_2
			# --- drawn at the end of turn 1 (hand of 6) ---
			# Gandalf, Stormcrow: cost 4, strength 8, no text
			gandalf: 0_64
			# Servant of the Secret Fire
			servant1: 1_83
			servant2: 1_83
			# Swordarm of the White Tower
			swordarm1: 1_116
			swordarm2: 1_116
			# Noble Intentions
			noble1: 1_304
			# --- drawn at the end of turn 2 ---
			# Aragorn, Heir of Elendil: cost 4, strength 8, defender +1
			aragorn: 4_109
			# Boromir, Steward's Heir: cost 3, strength 7, vitality 3
			boromir: 0_65
			noble2: 1_304
		}
		shadow: {
			# The opponent's own Ring-bearer.  The game puts one on the table for each player; this one never takes a turn.
			oppFrodo: 10_121
			# Goblin Bowman: cost 2, strength 4, archer.  Starts in hand (see setup).
			bowman: 2_60
			# --- drawn at the end of turn 1 (hand of 8) ---
			# Mordor Soldier: cost 1, strength 3
			soldier: 7_290
			# Ancient Chieftain: cost 4, strength 9, +1 for each other [moria] Orc
			chieftain: 1_163
			# Drums in the Deep
			drums1: 1_168
			# Goblin Runner: cost 1, strength 5, adds (2) when played
			runner1: 1_178
			runner2: 1_178
			bowman2: 2_60
			# Goblin Marksman: cost 3, strength 7, archer
			marksman: 1_176
			# Moria Scout: cost 2, strength 6
			scout: 1_191
			# --- drawn at the end of turn 2 ---
			# Host of Moria: cost 7, strength 15, may play a [moria] card from discard when played
			host: 9_41
			drums2: 1_168
		}
	}
	ringBearer: {
		freeps: frodo
		shadow: oppFrodo
	}
	ring: {
		freeps: ring
	}

	# Green Hill Country (0), Breeland Forest (1), Rivendell Valley (0, sanctuary), Great Chasm (4)
	sites: {
		freeps: 1_323, 1_329, 1_341, 2_118
		shadow: 1_323, 1_329, 1_341, 2_118
	}

	rules: {
		oneSided: true
		freeps: [
			# A hand of 6, so that the draws come out as the lessons need them
			{
				type: modifier
				modifier: {
					type: modifyHandSize
					amount: -2
				}
			}
			# The Ring is on the table from the first lesson, but what it does is a later one
			{
				type: modifier
				modifier: {
					type: disableGameText
					filter: name(The One Ring)
				}
			}
			# Maneuver is introduced in a later lesson
			{
				type: modifier
				modifier: {
					type: skipPhase
					phase: maneuver
				}
			}
		]
		shadow: [
			# Roaming is a later lesson: minions cost what their card says
			{
				type: modifier
				modifier: {
					type: modifyRoamingPenalty
					filter: minion
					amount: -2
				}
			}
		]
	}

	setup: {
		shadow: {
			hand: bowman
		}
	}

	outcome: {
		lose: {
			type: hasCardInDeadPile
			filter: companion
		}
		# NEW (Claude)
		loseMessage: One of your companions has fallen, and the fellowship cannot go on without them. Go back to the last checkpoint and look at the numbers again: who is about to be overwhelmed, and which card in your hand can stop it?
	}

	steps: [
		# ============================================================ TURN 1: site 1 to site 2, alone
		{
			when: freeps, action, phase(fellowship), turn(1)
			messages: [
				Welcome to the Lord of the Rings Trading Card Game!  In this tutorial series, you will play through several simplified scenarios which will slowly introduce you to each of the mechanics of the game and the interface here on Gemp.  Let's get started!
				{
					text: This is Frodo.  He is your **Ring-bearer**.  The Ring-bearer is your most important character; if he dies or falls to temptation, **you lose the game**.  Frodo bears...
					anchor: card:frodo
					highlight: card:frodo
				}
				{
					text: "...The One Ring!  This is a special card with special rules, but all you need to remember for now is that your Ring-bearer holds it and keeps it safe from the forces of evil."
					anchor: card:ring
					highlight: card:ring
				}
				{
					text: This is a **Site** card.  It is placed horizontally and represents where your Ring-bearer currently is in the wide world of Middle-earth.  Today we start the game at **[[Green Hill Country]]**.
					anchor: ui:site:1
					highlight: ui:site:1
				}
				{
					text: This is the **Adventure Path**.  Frodo will have to journey through 9 sites on his way to destroy the Ring, getting as close to Mount Doom as he can.  If your Ring-bearer survives combat on Site 9, you win!  Today, we will journey through 4 sites.
					anchor: ui:advPath
					highlight: ui:advPath
				}
				{
					text: On Gemp, you can hover over cards with your mouse to get a readable preview of the card.  You can also right-click (or swipe up on mobile devices) to open a card preview window.  Right-click on Frodo now.
					anchor: card:frodo
					highlight: card:frodo
					advance: inspect(frodo)
				}
				{
					text: Here you can see the text on the card, as well as a readout that tells you all the different effects which are altering Frodo's state.  In some games, you'll need to view this screen a lot!  Click outside this window or press ESC to dismiss it.
					anchor: ui:cardInfo
					advance: close
				}
				{
					text: The game is divided into **Phases**.  Right now, it is the **Fellowship Phase**, but Frodo is all alone, with no friends or equipment.  He's going to try to travel anyway, so we will go with him!  Click Pass to end the phase and move to the next site.
					anchor: ui:phase
					highlight: ui:phase
				}
			]
			allow: pass
		}
		{
			when: opponent, action, phase(shadow), turn(1)
			messages: [
				{
					text: Frodo has traveled to the **[[Breeland Forest]]** for Site 2.  When traveling, our heroes must avoid the attention of the forces of Shadow, but they are always watching and waiting....
					anchor: ui:site:2
					highlight: ui:site:2
				}
				{
					text: This is the **Twilight Pool**.  It represents how much attention Frodo has drawn on his journey.  The more Twilight is added to the pool, the more the forces of Shadow will start to take notice and pursue him.
					anchor: ui:twilightPool
					highlight: ui:twilightPool
				}
				{
					text: Every time you move to a new site, you will add 1 twilight per companion in your fellowship.  You will also add twilight equal to the new site's **Shadow Number**, shown here in the black orb in the upper right.
					zoom: site:2
					focus: shadowNumber
				}
			]
			answer: play(bowman)
		}
		{
			# The opponent has nothing left to play.  It is asked all the same, because this step is about its pass:
			# that is what lets something be said while it is still the Shadow phase.
			when: opponent, action, phase(shadow), turn(1)
			messages: [
				{
					# CHANGED: "It costs 2 ... leaving 1 remaining" are now filled in from the game (2, and 0 at Breeland Forest)
					text: It is now the **Shadow Phase**, and your opponent is sending creatures to hunt down Frodo.  This [[Goblin Bowman]] has sniffed him out!  It costs {cost:bowman} twilight, which is removed from the Twilight Pool, leaving {twilight} remaining.
					anchor: card:bowman
					highlight: card:bowman, ui:twilightPool
				}
			]
			answer: pass
		}
		{
			when: freeps, action, phase(archery), turn(1)
			messages: [
				{
					text: After the Shadow player has finished making actions, we move on to other phases.  Now we are at the **Archery Phase**.  This Goblin has the bold keyword **Archer** in its game text, which means it will fire one arrow at us.  You don't have any archers of your own, so click Pass.
					anchor: card:bowman
					highlight: card:bowman:text
				}
			]
			allow: pass
		}
		{
			when: freeps, assign, turn(1)
			messages: [
				{
					text: Ouch!  Frodo has taken an arrow.  That **wound** is represented with a red bead.
					anchor: card:frodo
					highlight: card:frodo:wounds
					highlightStyle: red
				}
				{
					# CHANGED: "from 4 to 3": the 3 is filled in from the game
					text: Frodo's **Vitality** (shown in the red orb) has gone down, from 4 to {vitality:frodo}.  If he takes too many more wounds, he will die, and his quest will fail.  Keep your Ring-bearer safe!
					anchor: card:frodo
					highlight: card:frodo:vitality
					highlightStyle: red
				}
				{
					text: "**Minions** are cards representing the evil creatures and people in the world.  The [[Goblin Bowman]] is ready to fight, so we must draw our swords."
					anchor: card:bowman
					highlight: card:bowman
				}
				{
					text: During the **Assignment Phase**, you will choose who fights.  Every minion must be assigned to one of your companions.  Click on the Goblin to assign it.
					anchor: card:bowman
					avoid: card:frodo
				}
				{
					text: Once clicked, you will have to choose who fights it.  Frodo is the only companion you have, so click on him.
					anchor: card:frodo
					on: picked(bowman)
				}
				{
					text: There are no other minions to assign, so click Done.
					anchor: ui:button:done
					on: ready
				}
			]
			allow: assign(frodo: bowman)
		}
		{
			when: freeps, cards, text(next skirmish), turn(1)
			messages: [
				{
					text: Now we move on to the **Skirmish Phase**.  Every assigned pair of characters will fight in their own individual battle.  Click on Frodo to begin his skirmish.
					anchor: ui:assignment:frodo
				}
			]
			allow: choose(frodo)
		}
		{
			when: freeps, action, phase(skirmish), turn(1)
			messages: [
				{
					text: Skirmishes are a contest of **Strength**. Strength is the number on the brown shield icon, and represents battle prowess.  Whoever has more strength wins the skirmish.  But right now, both sides are tied!  Shadow plays dirty, so minions always win skirmish ties.  Click Pass to end the skirmish.
					anchor: ui:skirmish
					highlight: card:frodo:strength, card:bowman:strength
				}
			]
			allow: pass
		}
		{
			when: freeps, choice, text(another move), turn(1)
			messages: [
				{
					# CHANGED: "down to 2 vitality": filled in from the game
					text: The loser of a skirmish takes 1 wound.  Frodo is now down to {vitality:frodo} vitality, and in dire need of help.
					anchor: card:frodo
					highlight: card:frodo:wounds
					highlightStyle: red
				}
				{
					text: In the **Regroup Phase**, your fellowship must choose whether to continue traveling, or to hide.  If you stay and hide, all minions on the table will be discarded, and you will **reconcile** your hand.  Let's stay; choose No on the pop-up.
					anchor: ui:dialog
					avoid: card:frodo
				}
			]
			allow: option(No)
		}

		# ============================================================ TURN 2: site 2 to site 3, with Gandalf
		{
			checkpoint: true
			when: freeps, action, phase(fellowship), turn(2)
			messages: [
				{
					text: Now we have reconciled our hand, drawing cards!  Since we chose to stay, it is now the **Fellowship Phase** once again.  This is our chance to play companions and other cards.
					anchor: zone:self.hand
					highlight: zone:self.hand
					side: above
				}
				{
					# CHANGED: "costs 4": filled in from the game
					text: We've drawn Gandalf!  Gandalf is a companion who costs {cost:gandalf}; a hefty sum but a Wizard is always worth it.
					anchor: card:gandalf
					highlight: card:gandalf
					avoid: zone:self.characters
				}
			]
			allow: play(gandalf)
		}
		{
			when: freeps, action, phase(fellowship), turn(2)
			messages: [
				{
					text: Gandalf now joins Frodo on his journey.  Your fellowship is growing!
					anchor: card:gandalf
					highlight: card:gandalf
				}
				{
					text: These other cards are Events.  They represent moments of bravery, luck, or skill, and we will have a chance to use them later. Click Pass to end the Fellowship Phase.
					anchor: zone:self.hand
					highlight: zone:self.hand
					side: above
				}
			]
			allow: pass
		}
		{
			when: opponent, action, phase(shadow), turn(2)
			messages: [
				{
					# CHANGED: "putting us at (6) total": filled in from the game
					text: The fellowship has made it to Rivendell at Site 3...but they are being chased by Orcs! Rivendell has a Shadow Number of 0, but we still add (1) per companion, putting us at ({twilight}) total (remember, we paid ({cost:gandalf}) twilight for Gandalf).
					anchor: ui:twilightPool
					highlight: ui:twilightPool, ui:site:3
				}
			]
			answer: play(soldier)
		}
		{
			when: opponent, action, phase(shadow), turn(2)
			answer: play(chieftain)
		}
		{
			when: freeps, assign, turn(2)
			messages: [
				{
					text: There are no archers this time, so we proceed to the Assignment Phase. There are 2 minions, so we will have to assign them to 2 companions.  Assign the Soldier to Gandalf.
					anchor: card:soldier
					avoid: card:gandalf, card:frodo, card:chieftain
				}
				{
					text: Next, assign the Chieftain to Frodo.
					anchor: card:chieftain
					avoid: card:frodo
					on: assigned(gandalf)
				}
				{
					text: If you ever make a mistake, you can click on an assigned minion to assign it to someone else (or click on it again to unassign it).  Click Done to lock in these assignments.
					anchor: ui:button:done
					on: ready
				}
			]
			allow: assign(gandalf: soldier, frodo: chieftain)
		}
		{
			when: freeps, cards, text(next skirmish), turn(2)
			messages: [
				{
					text: Now that there are two skirmishes, you must decide which order to perform them in.  Let's do Gandalf's skirmish first.
					anchor: ui:assignment:gandalf
				}
			]
			allow: choose(gandalf)
		}
		{
			when: freeps, action, phase(skirmish), turn(2)
			messages: [
				{
					text: Some fights are so one-sided that the loser has no chance of getting away.  If one side **doubles** the strength of the other at the end of a skirmish, the loser is **overwhelmed** and immediately dies, regardless of how much vitality they have left.
					anchor: ui:skirmish
				}
				{
					# CHANGED: "Gandalf's 7 strength ... the Soldier's 3": filled in from the game (Stormcrow is 8)
					text: Gandalf's {strength:gandalf} strength is more than double the Soldier's {strength:soldier} strength.  Click Pass to end the skirmish and put the Orc in the ground.
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: {
				answers: pass
				# NEW (Claude)
				otherwise: Gandalf doesn't need any help with this one. Save your Events for a fight that does.
			}
		}
		{
			when: freeps, cards, text(next skirmish), turn(2)
			messages: [
				{
					text: Now it's time for Frodo to fight.
					anchor: ui:assignment:frodo
				}
			]
			allow: choose(frodo)
		}
		{
			when: freeps, action, phase(skirmish), turn(2)
			messages: [
				{
					# CHANGED: "His 4 strength ... the Chieftain's 9": filled in from the game
					text: Frodo is in trouble.  His {strength:frodo} strength isn't enough to survive against the Chieftain's {strength:chieftain}!  Let's play an Event to rescue him!
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
				{
					text: Events will say in their game text or type bar when they can be played.  [[Servant of the Secret Fire]] has **Skirmish** in its game text, and it is the Skirmish phase, so now is the perfect time.
					zoom: card:servant1
					focus: text
				}
				{
					text: "\"Spot X\" means that X must be on the table and active.  We can spot Gandalf, so we are permitted to play this now."
					anchor: card:servant1
					highlight: card:gandalf
				}
			]
			# Either copy will do.  The ? says "if it is on offer": by the next step one of them has been played.
			allow: play(servant1)?, play(servant2)?
			answer: play(servant1)
		}
		{
			when: opponent, action, phase(skirmish), turn(2)
			messages: [
				{
					# CHANGED: "from 9 to 7": Servant of the Secret Fire is strength -3, so the game says 6
					text: The Chieftain has been reduced from 9 to {strength:chieftain} strength.  Frodo may survive this yet!
					anchor: card:chieftain
					highlight: card:chieftain:strength
				}
			]
			answer: play(drums1)
		}
		{
			when: freeps, action, phase(skirmish), turn(2)
			messages: [
				{
					text: Oh no!  Your opponent played an event of their own!  Look down here in the **Combat Log** to see it.  You can click or hover over the blue text to see what was played if you missed it, and scroll up to see a log of everything that's happened recently.
					anchor: ui:gameLog
					highlight: ui:gameLog
					highlightStyle: blue
				}
				{
					text: "**[[Drums in the Deep]]** made the Chieftain strength +2.  Frodo is once more in danger of being overwhelmed.  Let's play the second copy of [[Servant of the Secret Fire]]."
					anchor: zone:self.hand
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: play(servant1)?, play(servant2)?
			answer: play(servant2)
		}
		{
			when: freeps, action, phase(skirmish), turn(2)
			messages: [
				{
					text: Phew, our opponent didn't play another event.  Click Pass to end the skirmish.
					anchor: ui:skirmish
				}
			]
			allow: pass
		}
		{
			when: freeps, choice, text(another move), turn(2)
			messages: [
				{
					text: Frodo took 1 wound and avoided being overwhelmed.  However, he is now **exhausted**--only 1 wound away from death.  Some cards will punish you for being exhausted, but more importantly, he's almost dead!
					anchor: card:frodo
					highlight: card:frodo:wounds
					highlightStyle: red
				}
				{
					text: It is now the Regroup phase.  Time to hide from these Orcs, and reconcile our hand again.
					anchor: ui:dialog
					avoid: card:frodo
				}
			]
			allow: option(No)
		}
		{
			# The game asks this whenever you reconcile with cards in hand, so it has to be answered.
			when: freeps, cards, text(Reconcile), turn(2)
			messages: [
				{
					# NEW (Claude): the script has nothing for this prompt
					text: When you reconcile, you may first discard one card from your hand, to make room for one more new one.  We want to keep all of these, so click Done.
					anchor: zone:self.hand
					side: above
				}
			]
			allow: pass
		}

		# ============================================================ TURN 3: site 3 to site 4, the whole fellowship
		{
			checkpoint: true
			when: freeps, cards, text(Sanctuary healing)
			until: freeps, action, phase(fellowship)
			messages: [
				{
					text: It is the start of the **Fellowship Phase** once more!  Rivendell is a **sanctuary**, which you can tell by its grey color.  All site 3s and site 6s are sanctuaries, which are a place where you can rest and heal.  You may heal up to 5 wounds from your companions now, so get Frodo all healed up!
					anchor: card:frodo
					highlight: ui:site:3
				}
			]
			allow: choose(frodo)
			answer: choose(frodo), choose(frodo), choose(frodo)
		}
		{
			when: freeps, action, phase(fellowship), turn(3)
			until: phase(shadow)
			messages: [
				{
					text: And now it is time to play more companions.  Add Aragorn and Boromir to the fellowship, and click Pass once you are ready to move on.
					anchor: zone:self.hand
					highlight: card:aragorn, card:boromir
					side: above
				}
			]
			allow: {
				answers: play(aragorn), play(boromir)
				passWhen: [
					{
						type: canSpot
						filter: alias(aragorn)
					}
					{
						type: canSpot
						filter: alias(boromir)
					}
				]
				# NEW (Claude)
				otherwise: Both Aragorn and Boromir are coming with us. Play the two of them first.
			}
			answer: play(aragorn), play(boromir), pass
		}
		{
			when: opponent, action, phase(shadow), turn(3)
			messages: [
				{
					# CHANGED: "15 twilight": filled in from the game
					text: We add (4) for our growing fellowship, and (4) more from the site.  {twilight} twilight is quite a lot...
					anchor: ui:twilightPool
					highlight: ui:twilightPool
				}
			]
			answer: play(runner1)
		}
		{
			when: opponent, action, phase(shadow), turn(3)
			messages: [
				{
					text: Your opponent has played a [[Goblin Runner]].  It has game text that triggers upon being played, which in this case adds (2) twilight.  But it's just one Orc, so...
					anchor: card:runner1
					highlight: card:runner1:text
				}
			]
			answer: play(runner2)
		}
		{
			when: opponent, action, phase(shadow), turn(3)
			answer: play(bowman2)
		}
		{
			when: opponent, action, phase(shadow), turn(3)
			answer: play(marksman)
		}
		{
			when: opponent, action, phase(shadow), turn(3)
			answer: play(scout)
		}
		{
			when: opponent, action, phase(shadow), turn(3)
			answer: play(host)
		}
		{
			# Host of Moria's trigger is optional, so the opponent is asked whether to use it
			when: opponent, action, text(Optional responses), turn(3)
			messages: [
				"...uh-oh."
				{
					text: "[[Host of Moria]] also has an on-play trigger, one that gets to play a card from your opponent's discard pile..."
					anchor: card:host
					highlight: card:host:text
				}
			]
			answer: use(host)
		}
		{
			when: opponent, arbitrary, turn(3)
			answer: choose(chieftain)
		}
		{
			when: opponent, action, phase(shadow), turn(3)
			messages: [
				{
					text: "...we've seen this [[Ancient Chieftain]] before.  Minions cannot ever truly die; while you can chase them into the discard pile, they might find a way to claw their way back to your fellowship."
					anchor: card:chieftain
					highlight: card:chieftain
				}
			]
			answer: pass
		}
		{
			when: freeps, cards, text(archery wound), turn(3)
			until: freeps, assign
			messages: [
				{
					text: 2 of your enemies have the **archer** keyword, so they will fire 2 arrows at you.  Mercifully, you get to decide where those arrows land.  Choose wisely.
					anchor: zone:self.characters
					highlight: card:bowman2, card:marksman
					highlightStyle: red
				}
			]
			allow: {
				answers: choose(frodo), choose(gandalf), choose(aragorn)
				hints: {
					# NEW (Claude).  Two arrows on Boromir and he dies when he loses his skirmish, so he is kept out of it.
					boromir: Boromir has the least vitality of your Men, and the biggest Orc on the table is coming for him.  Let someone sturdier take the arrow.
				}
			}
			answer: choose(frodo), choose(frodo)
		}
		{
			when: freeps, assign, turn(3)
			messages: [
				{
					text: Aragorn has **Defender +1**.  This means that you can assign 1 additional minion to him, letting him fight 2 Orcs at once.  Let's assign a [[Goblin Marksman]] and a [[Goblin Bowman]] to him.
					anchor: card:aragorn
					highlight: card:aragorn:text
				}
				{
					text: Boromir is a brave warrior, so assign the [[Host of Moria]] to him.
					anchor: card:boromir
					on: assigned(aragorn)
				}
				{
					text: Gandalf will take on the [[Ancient Chieftain]].
					anchor: card:gandalf
					on: assigned(boromir)
				}
				{
					# CHANGED: was "And Frodo can fight the other Bowman."  There is only one Bowman on the table (and
					# only 2 archers); the Scout is the minion left over that there is one of.
					text: And Frodo can fight the [[Moria Scout]].
					anchor: card:frodo
					on: assigned(gandalf)
				}
				{
					# CHANGED: the last sentence is added.  This is said before the assignment is confirmed, and Gemp
					# asks "At least one minion has not been assigned, do you want to proceed?" when Done is clicked.
					text: "...there are too many of them.  You have no more companions left, so your opponent gets to decide who the remaining minions will fight.  Click Done, and tell Gemp that yes, you mean it."
					anchor: ui:button:done
					on: ready
				}
			]
			allow: assign(aragorn: marksman + bowman2, boromir: host, gandalf: chieftain, frodo: scout)
		}
		{
			when: opponent, assign, turn(3)
			answer: assign(frodo: runner1 + runner2)
		}
		{
			# Read, not answered: the decision underneath (which skirmish first) belongs to whichever step follows.
			checkpoint: true
			pause: true
			when: freeps, cards, text(next skirmish), turn(3)
			messages: [
				{
					text: As expected, they seek out the Ring and attack Frodo.  This looks bad.  Take a moment and think; read the cards on the table and in your hand and see if you can make a plan for how to execute each skirmish to keep all of your companions alive.
					anchor: ui:assignment:frodo
					highlight: ui:assignment:frodo
					highlightStyle: red
					choices: {
						plan: I have a plan
						help: Help me see victory
					}
				}
			]
		}

		# ------------------------------------------------------------ "I have a plan": the skirmishes are the player's
		{
			if: plan
			when: freeps, turn(3)
			until: freeps, action, phase(regroup)
			# What the headless runner plays, to prove this way through can be won
			answer: [
				choose(boromir), play(swordarm1), choose(boromir), pass
				choose(aragorn), play(swordarm2), choose(aragorn), pass
				choose(gandalf), pass, pass
				choose(frodo), play(noble1), choose(aragorn), play(noble2), choose(gandalf), pass
			]
		}

		# ------------------------------------------------------------ "Help me see victory": one skirmish at a time
		{
			if: help
			when: freeps, cards, text(next skirmish), turn(3)
			messages: [
				{
					text: First, let's resolve Boromir's skirmish.
					anchor: ui:assignment:boromir
				}
			]
			allow: choose(boromir)
		}
		{
			if: help
			when: freeps, action, phase(skirmish), turn(3)
			messages: [
				{
					# CHANGED: "7 strength to the Host's 15": filled in from the game
					text: Boromir is {strength:boromir} strength to the Host's {strength:host}, which is very close to the overwhelm boundary.  Play a [[Swordarm of the White Tower]] to push him into safety.  He is not defender +1, so he only gets +2 strength.
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: play(swordarm1)?, play(swordarm2)?
			answer: play(swordarm1)
		}
		{
			# The card asks who gets the strength.  No message of yours for this one, so there is only a hint.
			if: help
			when: freeps, cards, text(modify strength), turn(3)
			allow: {
				answers: choose(boromir)
				# NEW (Claude)
				otherwise: This one is for Boromir.  He is the one in trouble right now.
			}
		}
		{
			if: help
			when: freeps, action, phase(skirmish), turn(3)
			messages: [
				{
					# NEW (Claude): the script has no message for this pass
					text: Boromir is now {strength:boromir} strength.  He will lose and take a wound, but he will not be overwhelmed.  Click Pass.
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: pass
		}
		{
			if: help
			when: freeps, cards, text(next skirmish), turn(3)
			messages: [
				{
					text: Aragorn next.
					anchor: ui:assignment:aragorn
				}
			]
			allow: choose(aragorn)
		}
		{
			if: help
			when: freeps, action, phase(skirmish), turn(3)
			messages: [
				{
					# CHANGED: "8 strength versus a combined 12": filled in from the game.  Marksman 7 + Bowman 4 is 11;
					# at 12 Aragorn's 12 would only tie, and ties go to the Shadow.
					text: Aragorn is {strength:aragorn} strength versus a combined {shadowStrength} strength against him.  However he *is* defender +1, so let's play the other Swordarm.
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: play(swordarm1)?, play(swordarm2)?
			answer: play(swordarm2)
		}
		{
			if: help
			when: freeps, cards, text(modify strength), turn(3)
			messages: [
				{
					text: Make sure to select Aragorn as your target and not Boromir!  Both of them are [gondor] companions, so don't misclick!
					anchor: card:aragorn
					avoid: card:boromir
				}
			]
			allow: choose(aragorn)
		}
		{
			if: help
			when: freeps, action, phase(skirmish), turn(3)
			messages: [
				{
					text: Aragorn was made +4 strength, pushing him to be the winner!  Each loser in this skirmish will get 1 wound, which kills them both.
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: pass
		}
		{
			if: help
			when: freeps, cards, text(next skirmish), turn(3)
			messages: [
				{
					text: Gandalf is next.
					anchor: ui:assignment:gandalf
				}
			]
			allow: choose(gandalf)
		}
		{
			if: help
			when: freeps, action, phase(skirmish), turn(3)
			messages: [
				{
					# CHANGED: "is therefore only 13": filled in from the game.  "was 15" is written out (9, +1 for each
					# of the six other [moria] Orcs).
					text: The Chieftain was 15 strength, but because Aragorn killed two Orcs, they are no longer on the table and thus no longer able to be spotted.  Chieftain is therefore only {strength:chieftain}, not enough to overwhelm Gandalf.
					anchor: ui:skirmish
					highlight: card:chieftain:strength
				}
			]
			allow: pass
		}
		{
			# The opponent has played its second Drums in the Deep (one of its standing orders, at the top of the file)
			if: help
			when: freeps, action, phase(skirmish), turn(3)
			messages: [
				{
					# NEW (Claude): Gandalf, Stormcrow is strength 8, so 15 would not have overwhelmed him either.  With
					# the drums it would have: 17.  This is what makes "fight Aragorn's skirmish first" true.
					text: "[[Drums in the Deep]] again!  The Chieftain is back up to {strength:chieftain}.  If those two Orcs were still on the table he would be 17, more than double Gandalf's {strength:gandalf}, and Gandalf would be dead.  The order you fight your skirmishes in matters!  Click Pass."
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: pass
		}
		{
			if: help
			when: freeps, cards, text(next skirmish), turn(3)
			messages: [
				{
					text: That leaves Frodo at the last.
					anchor: ui:assignment:frodo
				}
			]
			allow: choose(frodo)
		}
		# Everything from here to the end is NEW (Claude): your messages stop at "That leaves Frodo at the last."
		{
			if: help
			when: freeps, action, phase(skirmish), turn(3)
			messages: [
				{
					text: Three Orcs with {shadowStrength} strength between them, against Frodo's {strength:frodo}.  He cannot win this.  He doesn't have to!  He only has to avoid being overwhelmed, and for that he needs more than half their strength.
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
				{
					text: "[[Noble Intentions]] lets one of his friends lend him theirs.  It has a cost: you must **exert** a companion who is not a Hobbit.  Exerting means that character takes a wound, as payment."
					zoom: card:noble1
					focus: text
				}
				{
					text: A wound is a fair price for Frodo's life.  Play [[Noble Intentions]] now.
					anchor: zone:self.hand
					side: above
				}
			]
			allow: play(noble1)?, play(noble2)?
			answer: play(noble1)
		}
		{
			# Who pays is left to the player: whoever can still exert is on offer, and any of them will do
			if: help
			when: freeps, cards, text(exert), turn(3)
			messages: [
				{
					text: Choose who exerts.  They will take the wound, so pick someone who can spare it.
					anchor: zone:self.characters
				}
			]
			answer: choose(aragorn)
		}
		{
			if: help
			when: freeps, action, phase(skirmish), turn(3)
			messages: [
				{
					text: Frodo is up to {strength:frodo}, but {shadowStrength} is still more than double that.  You have a second copy.  Play it!
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: play(noble1)?, play(noble2)?
			answer: play(noble2)
		}
		{
			if: help
			when: freeps, cards, text(exert), turn(3)
			answer: choose(gandalf)
		}
		{
			if: help
			when: freeps, action, phase(skirmish), turn(3)
			messages: [
				{
					text: "{strength:frodo} against {shadowStrength}.  Frodo will lose, and take a wound for it, but he will live.  Click Pass."
					anchor: ui:skirmish
					highlight: ui:skirmish:fpStrength, ui:skirmish:shadowStrength
				}
			]
			allow: pass
		}

		# ------------------------------------------------------------ both ways through end here
		{
			# Regroup is passed for the player (options.autoPass), but they are asked here because this step is over
			# that pass.  Being a pause, it ends the scenario when it has been read.
			pause: true
			when: freeps, action, phase(regroup), turn(3)
			messages: [
				{
					text: The Orcs have nothing to show for it.  Every one of your companions is still standing, and the Ring is still safe in Frodo's keeping.
					anchor: zone:self.characters
					highlight: zone:self.characters
					highlightStyle: green
				}
				{
					text: In a full game the road goes on all the way to Site 9, with a deck of your own, an opponent who is trying to get their own Ring-bearer there first, and a Ring that does a great deal more than sit there.  All of that is still to come.  For today, you have brought the fellowship through alive.  Well done!
				}
			]
			end: complete
		}
	]
}
