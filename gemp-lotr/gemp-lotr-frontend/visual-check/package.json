{
  "name": "gemp-deckbuilder-visual-check",
  "private": true,
  "description": "Compares the Angular deck builder with the legacy deckBuild.html in a real browser (see README.md). Not part of the Maven build.",
  "type": "module",
  "scripts": {
    "check": "node run.mjs",
    "check:stubbed": "node run.mjs --stubbed --out report-stubbed",
    "check:local": "node local-server.mjs",
    "check:local:down": "node local-server.mjs down",
    "check:matrix": "node local-server.mjs --matrix --mutating --sizes 1366x768 --tolerance 80 --out report-matrix",
    "check:selftest": "node local-server.mjs --selftest",
    "check:deploy": "node deploy-test.mjs",
    "check:server-build": "node tools/build-server.mjs",
    "check:all": "node tools/check-all.mjs",
    "inspect": "node tools/inspect.mjs",
    "check:mutation": "node tools/mutation.mjs",
    "check:legacy-decks": "node local-server.mjs --legacy-decks"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "pngjs": "7.0.0"
  }
}
