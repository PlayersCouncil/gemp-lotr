{
  "name": "gemp-deckbuilder-visual-check",
  "private": true,
  "description": "Compares the Angular deck builder with the legacy deckBuild.html in a real browser (see README.md). Not part of the Maven build.",
  "type": "module",
  "scripts": {
    "check": "node run.mjs",
    "check:stubbed": "node run.mjs --stubbed --out report-stubbed",
    "check:local": "node local-server.mjs",
    "check:local:down": "node local-server.mjs down",
    "check:matrix": "node local-server.mjs --matrix --mutating --sizes 1366x768 --tolerance 80 --out report-matrix",
    "check:phone": "node local-server.mjs --phone --mutating --sizes 390x844 --out report-phone",
    "check:selftest": "node local-server.mjs --selftest",
    "check:deploy": "node deploy-test.mjs",
    "check:server-build": "node tools/build-server.mjs",
    "check:all": "node tools/check-all.mjs",
    "inspect": "node tools/inspect.mjs",
    "measure": "node tools/measure.mjs",
    "check:mutation": "node tools/mutation.mjs",
    "check:legacy-decks": "node local-server.mjs --legacy-decks",
    "check:game": "node game/local.mjs",
    "check:game:down": "node game/local.mjs down",
    "check:game:selftest": "node game/local.mjs --selftest",
    "check:game:table": "node game/table.mjs",
    "check:game:modern": "node game/local.mjs --pages legacy,angular --theme modern --geometry --out report-game-modern",
    "check:game:phone": "node game/phone.mjs",
    "check:game:devices": "node game/devices.mjs",
    "check:game:phones": "npm --prefix .. run build -- --output-path visual-check/.local-server/ng && node game/local.mjs --pages legacy,angular --devices tablet,tablet-sideways,phone,phone-sideways --out report-game-phones",
    "check:game:generated": "node game/table.mjs --generated 100 --steps last --out report-game-generated",
    "check:game:record": "node game/local.mjs --record --sizes 1366x768",
    "check:game:matrix": "node game/local.mjs --matrix --pages legacy,angular --sizes 1366x768 --out report-game-matrix",
    "tunnel": "node tools/tunnel.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "pngjs": "7.0.0"
  }
}
